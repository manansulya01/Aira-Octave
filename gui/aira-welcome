#!/bin/sh
# AiraOS Welcome / First Run Wizard - helps new users understand the system.
# Runs on first boot or when explicitly invoked.

WELCOME_DIR="$HOME/.config/aira"
WELCOME_FLAG="$WELCOME_DIR/welcome-done"
mkdir -p "$WELCOME_DIR"

# Skip if already shown (unless --force)
if [ -f "$WELCOME_FLAG" ] && [ "${1:-}" != "--force" ]; then
    exit 0
fi

export DISPLAY="${DISPLAY:-:0}"

show_welcome() {
    cat <<'WELCOME_EOF'
╔══════════════════════════════════════════════════════════════════════════════╗
║                                                                              ║
║    █████╗ ██████╗  █████╗ ███████╗██╗   ██╗                                 ║
║   ██╔══██╗██╔══██╗██╔══██╗██╔════╝╚██╗ ██╔╝                                 ║
║   ███████║██████╔╝███████║█████╗   ╚████╔╝                                  ║
║   ██╔══██║██╔══██╗██╔══██║██╔══╝    ╚██╔╝                                   ║
║   ██║  ██║██║  ██║██║  ██║███████╗   ██║                                    ║
║   ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═╝╚══════╝   ╚═╝                                    ║
║                                                                              ║
║                        Welcome to AiraOS-Octave!                            ║
║                                                                              ║
╚═════════════════════════════════════════════════════════════════════════════╝

AiraOS is a complete, bootable operating system designed to be
simple, transparent, and hackable.

┌─ QUICK START ─────────────────────────────────────────────────────────────┐
│                                                                             │
│  🖥  TERMINAL     Press Alt+F2 or click "Terminal" in the taskbar          │
│  📁 FILES        Press Alt+F3 or click "Files" to browse your system       │
│  ✏️  EDITOR       Press Alt+F4 or click "Editor" to edit text files        │
│  ⚙️  SETTINGS     Press Alt+F5 or click "Settings" to configure system     │
│  📊 MONITOR      Press Alt+F6 to see CPU, memory, and processes            │
│  🌐 NETWORK      Press Alt+F7 to manage network connections                │
│  📦 PACKAGES     Press Alt+F8 to install/remove software                   │
│  ℹ️  ABOUT        Press Alt+F9 for system information                      │
│                                                                             │
│  🖱  RIGHT-CLICK on desktop for application menu                           │
│  ⌨️  Alt+Tab to switch between windows                                     │
│  🖥  Alt+F1 opens the main menu                                            │
│                                                                             │
└─────────────────────────────────────────────────────────────────────────────┘

┌─ KEY CONCEPTS ────────────────────────────────────────────────────────────┐
│                                                                             │
│  • Everything runs in a graphical desktop (JWM window manager)             │
│  • Applications are real programs, not simulations                         │
│  • Your files persist if you boot with a virtual disk (-drive)             │
│  • System settings are changed through the Settings app                    │
│  • Software is managed via Package Center (airapkg)                        │
│  • The system uses a local IPC bus for service communication               │
│                                                                             │
└─────────────────────────────────────────────────────────────────────────────┘

┌─ USEFUL COMMANDS (in Terminal) ───────────────────────────────────────────┐
│                                                                             │
│  aira help           Show all system commands                              │
│  aira system         Show kernel, CPU, memory, disk info                   │
│  aira status         Show running services and mounts                      │
│  aira doctor         Run system health check                               │
│  aira diagnose       Full diagnostic dump                                  │
│  aira demo           Guided tour of the system                             │
│  airapk list         List installed packages                               │
│  airapk search <term> Search for packages                                  │
│  airapkg install <file.apkg> Install a package                             │
│                                                                             │
