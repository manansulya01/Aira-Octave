Press Enter to continue, or 'q' to skip this welcome screen.
WELCOME_EOF
}

if [ -n "${DISPLAY:-}" ] && command -v xmessage >/dev/null 2>&1; then
    # Graphical welcome
    show_welcome | xmessage -file - -buttons "Get Started:0,Skip:1" -title "Welcome to AiraOS-Octave" -center -default "Get Started" 2>/dev/null
    RESULT=$?
else
    # Text welcome
    show_welcome
    read -r input
    case "$input" in
        q|Q) RESULT=1 ;;
        *) RESULT=0 ;;
    esac
fi

if [ "$RESULT" = "0" ]; then
    # Show a quick tour of the desktop
    if [ -n "${DISPLAY:-}" ] && command -v xmessage >/dev/null 2>&1; then
        cat <<'TOUR_EOF' | xmessage -file - -buttons OK:0 -title "AiraOS Desktop Tour" -center 2>/dev/null
