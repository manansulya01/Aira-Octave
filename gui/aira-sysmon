#!/bin/sh
# AiraOS System Monitor - real-time CPU, memory, processes, storage, network monitoring.
export DISPLAY="${DISPLAY:-:0}"

if [ "${1:-}" = "--once" ]; then
    # One-shot output for tests/integrations
    echo "=== AiraOS System Monitor ($(date '+%H:%M:%S')) ==="
    echo "--- cpu ---"
    grep -m1 "model name" /proc/cpuinfo 2>/dev/null
    awk '/^cpu /{printf "cpu user=%s nice=%s sys=%s idle=%s iowait=%s\n",$2,$3,$4,$5,$6}' /proc/stat 2>/dev/null
    a1=$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $5+$6}' /proc/stat 2>/dev/null)
    sleep 1
    a2=$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $5+$6}' /proc/stat 2>/dev/null)
    set -- $a1; t1=${1:-0}; i1=${2:-0}
    set -- $a2; t2=${1:-0}; i2=${2:-0}
    if [ "$((t2-t1))" -gt 0 ] 2>/dev/null; then
        echo "cpu usage: $(((100*(t2-t1-(i2-i1)))/(t2-t1)))%"
    fi
    echo "--- load ---"
    cat /proc/loadavg 2>/dev/null
    echo "--- mem ---"
    awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{if(t>0) printf "mem used=%d MB free=%d MB total=%d MB (%d%% used)\n",(t-a)/1024,a/1024,t/1024,(100*(t-a))/t}' /proc/meminfo 2>/dev/null
    grep -E "MemTotal|MemFree|MemAvailable|SwapTotal|SwapFree" /proc/meminfo 2>/dev/null
    echo "--- uptime ---"
    awk '{d=int($1/86400); h=int(($1%86400)/3600); m=int(($1%3600)/60); printf "uptime: %dd %02d:%02d\n",d,h,m}' /proc/uptime 2>/dev/null
    echo "procs: $(ls -d /proc/[0-9]* 2>/dev/null | wc -l)"
    echo "--- top procs ---"
    ps -o pid,user,pcpu,pmem,comm,args 2>/dev/null | head -n 15 || ps 2>/dev/null | head -n 15
    echo "--- storage ---"
    df -h 2>/dev/null | head -n 10
    echo "--- network ---"
    ip -o -4 addr show 2>/dev/null | head -n 5 || echo "(no addresses)"
    exit 0
fi

# Graphical mode - run in xterm with live updates (theme single-sourced).
if [ -n "${DISPLAY:-}" ] && command -v xterm >/dev/null 2>&1; then
    _MBG="$(aira-theme get AIRA_BG 2>/dev/null)"; [ -n "$_MBG" ] || _MBG="#0b1026"
    _MFG="$(aira-theme get AIRA_FG 2>/dev/null)"; [ -n "$_MFG" ] || _MFG="#e8ecff"
    exec xterm \
        -fa "Monospace" -fs 10 \
        -bg "$_MBG" -fg "$_MFG" \
        -sb -sl 1000 \
        -T "AiraOS System Monitor" \
        -geometry 100x40+180+110 \
        -name aira-sysmon \
        -e sh -c 'while true; do clear; "$0" --once; sleep 2; done' "$0"
else
    # Fallback to one-shot
    "$0" --once
fi