#!/bin/sh
# AiraOS System Monitor: real CPU/mem/uptime/processes, refreshes every 2s.
# In X: xterm window. Without X: stdout once (--once, used by tests).
export DISPLAY="${DISPLAY:-:99}"
oneshot() {
  echo "=== AiraOS System Monitor ($(date '+%H:%M:%S')) ==="
  echo "--- cpu ---"
  grep -m1 "model name" /proc/cpuinfo 2>/dev/null
  awk '/^cpu /{printf "cpu user=%s nice=%s sys=%s idle=%s iowait=%s\n",$2,$3,$4,$5,$6}' /proc/stat 2>/dev/null
  # real 1s-sample CPU usage (kept fast for --once callers)
  a1=$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $5+$6}' /proc/stat 2>/dev/null)
  sleep 1
  a2=$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $5+$6}' /proc/stat 2>/dev/null)
  set -- $a1; t1=${1:-0}; i1=${2:-0}
  set -- $a2; t2=${1:-0}; i2=${2:-0}
  if [ "$((t2-t1))" -gt 0 ] 2>/dev/null; then
    echo "cpu usage: $(((100*(t2-t1-(i2-i1)))/(t2-t1)))%"
  fi
  echo "--- load ---"
  cat /proc/loadavg 2>/dev/null
  echo "--- mem ---"
  awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{if(t>0) printf "mem used=%d MB free=%d MB total=%d MB (%d%% used)\n",(t-a)/1024,a/1024,t/1024,(100*(t-a))/t}' /proc/meminfo 2>/dev/null
  grep -E "MemTotal|MemFree|MemAvailable" /proc/meminfo 2>/dev/null
  echo "--- uptime ---"
  awk '{d=int($1/86400); h=int(($1%86400)/3600); m=int(($1%3600)/60); printf "uptime: %dd %02d:%02d (%d procs)\n",d,h,m,0}' /proc/uptime 2>/dev/null
  echo "procs: $(ls -d /proc/[0-9]* 2>/dev/null | wc -l)"
  echo "--- top procs ---"
  ps -o pid,user,comm,args 2>/dev/null | head -n 12 || ps 2>/dev/null | head -n 12
}
if [ "${1:-}" = "--once" ]; then oneshot; exit 0; fi
if command -v xterm >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
  exec xterm -fa Monospace -fs 10 -bg "#0b1026" -fg "#e8ecff" -sb -T "AiraOS System Monitor" -geometry 84x28+180+110 -e sh -c 'while true; do clear; sh "$0" --once; sleep 2; done' "$0"
else
  oneshot
fi
