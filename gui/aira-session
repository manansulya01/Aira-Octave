#!/bin/sh
# aira-session — start AiraOS desktop.
# Auto-selects a VISIBLE Xorg desktop when graphical QEMU hardware is present
# (virtio-gpu DRM, or std VGA via vesa/fbdev fallback), otherwise uses Xvfb
# (headless/automated tests). Xvfb is kept as the headless fallback.
# Usage: aira-session [--auto] [--xorg] [--xvfb] [--headless]
#                     [--display :0] [--screen 1024x768x24]
case ":$PATH:" in
  *:/persist/usr/bin:*) ;;
  *) export PATH=/persist/usr/bin:/persist/bin:/persist/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin ;;
esac
export LD_LIBRARY_PATH=/persist/usr/lib/x86_64-linux-gnu:/persist/lib/x86_64-linux-gnu:/persist/usr/lib:/persist/lib:$LD_LIBRARY_PATH
DISP=":0"
GEOM="1024x768x24"
HEADLESS="no"
MODE="auto"
while [ $# -gt 0 ]; do
  case "$1" in
    --headless) HEADLESS="yes"; shift ;;
    --display) DISP="${2:-:0}"; shift 2 ;;
    --screen) GEOM="${2:-1024x768x24}"; shift 2 ;;
    --auto) MODE="auto"; shift ;;
    --xorg) MODE="xorg"; shift ;;
    --xvfb) MODE="xvfb"; shift ;;
    --help|-h)
      echo "Usage: aira-session [--auto|--xorg|--xvfb] [--headless] [--display :0] [--screen 1024x768x24]"
      echo "  --auto: visible Xorg when a GPU is present (virtio-gpu DRM, std-VGA fbdev), else Xvfb"
      echo "  --xorg/--xvfb: force backend; --headless: return after start (test harness)"
      exit 0 ;;
    *) shift ;;
  esac
done
# --- backend selection -------------------------------------------------------
# Visible Xorg needs a real framebuffer: /dev/dri/card* (virtio-gpu +
# modesetting, the reliable visible path) or a QEMU std-VGA PCI device
# (vesa/fbdev fallback). Headless runs (-nographic, no GPU) have neither
# usable target, so they stay on Xvfb. Explicit --xorg/--xvfb override.
USE_XVFB="yes"
if [ "$MODE" = "xvfb" ]; then
  USE_XVFB="yes"
elif [ "$MODE" = "xorg" ]; then
  USE_XVFB="no"
elif [ "$HEADLESS" = "yes" ]; then
  # Automated/headless tests: keep the proven invisible path.
  USE_XVFB="yes"
else
  if [ -e /dev/dri/card0 ] || ls /dev/dri/card* >/dev/null 2>&1; then
    USE_XVFB="no"
  elif [ -e /dev/fb0 ]; then
    USE_XVFB="no"
  else
    USE_XVFB="yes"
  fi
fi
if [ "$USE_XVFB" = "no" ] && ! command -v Xorg >/dev/null 2>&1; then
  echo "[aira-session] Xorg requested but not installed, falling back to Xvfb" >&2
  USE_XVFB="yes"
fi
if [ "$USE_XVFB" = "yes" ] && ! command -v Xvfb >/dev/null 2>&1; then
  if command -v Xorg >/dev/null 2>&1; then
    echo "[aira-session] Xvfb missing, trying Xorg" >&2
    USE_XVFB="no"
  else
    echo "aira-session: no X server found (need Xvfb or Xorg)" >&2
    exit 1
  fi
fi
export DISPLAY="$DISP"
# Socket dir + stale lock (guest /tmp is fresh tmpfs)
mkdir -p /tmp/.X11-unix 2>/dev/null
chmod 1777 /tmp/.X11-unix 2>/dev/null || true
rm -f "/tmp/.X${DISP#:}-lock" 2>/dev/null
# X helpers expected at fixed /usr/bin paths (rootfs at /persist)
mkdir -p /usr/bin 2>/dev/null
for t in xkbcomp Xvfb Xorg jwm xterm xmessage xsetroot xwininfo xwd xload xlsclients xprop mc setxkbmap xauth aira-net-indicator aira-storage-indicator aira-vol-indicator aira-power-indicator aira-clock aira-notify aira-notifyd aira-theme aira-wallpaper aira-launcher aira-quicksettings; do
  if [ ! -x "/usr/bin/$t" ] && [ -x "/persist/usr/bin/$t" ]; then
    ln -sf "/persist/usr/bin/$t" "/usr/bin/$t" 2>/dev/null || true
  fi
done
# Xorg module tree lives at /persist (Ubuntu-compiled paths are /usr/...).
# Symlink it into place so the Xorg wrapper + drivers resolve.
if [ -d /persist/usr/lib/xorg ]; then
  mkdir -p /usr/lib 2>/dev/null
  if [ ! -e /usr/lib/xorg ]; then
    ln -sfn /persist/usr/lib/xorg /usr/lib/xorg 2>/dev/null || true
  fi
fi
# fontconfig expects /etc/fonts + /usr/share/fonts (rootfs at /persist)
if [ ! -e /etc/fonts/fonts.conf ] && [ -e /persist/etc/fonts/fonts.conf ]; then
  mkdir -p /etc 2>/dev/null
  ln -sfn /persist/etc/fonts /etc/fonts 2>/dev/null || true
fi
if [ ! -e /usr/share/fonts/truetype ] && [ -e /persist/usr/share/fonts/truetype ]; then
  mkdir -p /usr/share 2>/dev/null
  ln -sfn /persist/usr/share/fonts /usr/share/fonts 2>/dev/null || true
fi
# XKB rules for Xorg autoconfig (rootfs at /persist)
if [ ! -e /usr/share/X11/xkb/rules/evdev ] && [ -e /persist/usr/share/X11/xkb/rules/evdev ]; then
  mkdir -p /usr/share/X11 2>/dev/null
  ln -sfn /persist/usr/share/X11/xkb /usr/share/X11/xkb 2>/dev/null || true
fi
if [ "$USE_XVFB" = "yes" ]; then
  echo "[aira-session] starting Xvfb $DISP $GEOM (headless fallback)"
  # Explicit font + xkb paths (rootfs at /persist when booted via initramfs)
  FPDIR="/persist/usr/share/fonts/X11/misc"
  [ -d "$FPDIR" ] || FPDIR="/usr/share/fonts/X11/misc"
  XKBDIR="/persist/usr/share/X11/xkb"
  [ -d "$XKBDIR" ] || XKBDIR="/usr/share/X11/xkb"
  Xvfb "$DISP" -screen 0 "$GEOM" -fp "$FPDIR" -xkbdir "$XKBDIR" +extension RANDR +extension RENDER > /tmp/Xvfb.log 2>&1 &
  XPID=$!
else
  # Visible Xorg path. Prefer modesetting on DRM (virtio-gpu); otherwise let
  # Xorg autoconfig pick fbdev/vesa (QEMU std VGA).
  # Input: Xorg's udev backend finds nothing in this minimal guest (no udev
  # daemon), and the libinput driver refuses non-udev-initialized nodes, so
  # discover evdev nodes via sysfs and pin them with static evdev(4)
  # InputDevice sections (the evdev driver opens /dev/input/eventN
  # directly, no udev needed). Attach EVERY keyboard and pointer found
  # (AT/PS/2 + virtio): QEMU/GTK/monitor may deliver through any of them.
  KBD_LIST=""; PTR_LIST=""
  for ev in /dev/input/event*; do
    [ -e "$ev" ] || continue
    n="${ev##*/}"; num="${n#event}"
    sys="/sys/class/input/event$num/device"
    nm="$(cat "$sys/name" 2>/dev/null || echo ?)"
    case "$nm" in
      *[Kk]eyboard*)
        case "$nm" in
          *AT*|*Translated*) KBD_LIST="$ev $KBD_LIST" ;;
          *) KBD_LIST="$KBD_LIST $ev" ;;
        esac
        ;;
    esac
    case "$nm" in
      *[Mm]ouse*|*PS/2*)
        case "$nm" in
          *PS/2*) PTR_LIST="$ev $PTR_LIST" ;;
          *) PTR_LIST="$PTR_LIST $ev" ;;
        esac
        ;;
    esac
  done
  # Capability fallback if name matching found nothing.
  if [ -z "$KBD_LIST" ] || [ -z "$PTR_LIST" ]; then
    for ev in /dev/input/event*; do
      [ -e "$ev" ] || continue
      n="${ev##*/}"; num="${n#event}"
      evcap="$(cat /sys/class/input/event$num/device/capabilities/ev 2>/dev/null || echo 0)"
      evcap="${evcap%% *}"
      if [ "$((0x$evcap & 2))" -ne 0 ] 2>/dev/null; then
        keycap="$(cat /sys/class/input/event$num/device/capabilities/key 2>/dev/null || echo)"
        case "$keycap" in *[!0\ ]*)
          case " $KBD_LIST " in *" $ev "*) ;; *) KBD_LIST="$KBD_LIST $ev" ;; esac ;;
        esac
      fi
      if [ "$((0x$evcap & 12))" -ne 0 ] 2>/dev/null; then
        case " $PTR_LIST " in *" $ev "*) ;; *) PTR_LIST="$PTR_LIST $ev" ;; esac
      fi
    done
  fi
  # Cap at two of each (primary + spare); AT/PS/2 were prepended = primary.
  KBD_LIST="$(echo $KBD_LIST | cut -d' ' -f1-2)"
  PTR_LIST="$(echo $PTR_LIST | cut -d' ' -f1-2)"
  echo "[aira-session] input nodes: kbd=[$KBD_LIST] ptr=[$PTR_LIST]"
  XORG_CONF=""
  if ls /dev/dri/card* >/dev/null 2>&1; then
    W="${GEOM%%x*}"; REST="${GEOM#*x}"; H="${REST%%x*}"
    [ -n "$W" ] || W="1024"; [ -n "$H" ] || H="768"
    XORG_CONF="/tmp/xorg-visible.conf"
    {
    cat <<EOF
Section "Device"
  Identifier "AiraGPU"
  Driver "modesetting"
  Option "AccelMethod" "none"
EndSection
Section "Monitor"
  Identifier "AiraMonitor"
EndSection
Section "Screen"
  Identifier "AiraScreen"
  Device "AiraGPU"
  Monitor "AiraMonitor"
  DefaultDepth 24
  SubSection "Display"
    Depth 24
    Modes "${W}x${H}"
  EndSubSection
EndSection
Section "ServerFlags"
  Option "AutoAddGPU" "off"
EndSection
EOF
    if [ -n "$KBD_LIST" ]; then
      i=0
      for kn in $KBD_LIST; do
        i=$((i+1))
        cat <<EOF
Section "InputDevice"
  Identifier "AiraKeyboard$i"
  Driver "evdev"
  Option "Device" "$kn"
  Option "XkbLayout" "us"
  Option "XkbRules" "evdev"
EndSection
EOF
      done
    fi
    if [ -n "$PTR_LIST" ]; then
      i=0
      for pn in $PTR_LIST; do
        i=$((i+1))
        cat <<EOF
Section "InputDevice"
  Identifier "AiraPointer$i"
  Driver "evdev"
  Option "Device" "$pn"
EndSection
EOF
      done
    fi
    if [ -n "$KBD_LIST" ] || [ -n "$PTR_LIST" ]; then
      {
      echo 'Section "ServerLayout"'
      echo '  Identifier "AiraLayout"'
      echo '  Screen "AiraScreen"'
      i=0
      for kn in $KBD_LIST; do
        i=$((i+1))
        echo "  InputDevice \"AiraKeyboard$i\" \"CoreKeyboard\""
      done
      i=0
      for pn in $PTR_LIST; do
        i=$((i+1))
        echo "  InputDevice \"AiraPointer$i\" \"CorePointer\""
      done
      echo 'EndSection'
      }
    fi
    } > "$XORG_CONF"
    echo "[aira-session] starting Xorg $DISP (modesetting, ${W}x${H})"
    Xorg "$DISP" -config "$XORG_CONF" > /tmp/Xorg.log 2>&1 &
    XPID=$!
  else
    echo "[aira-session] starting Xorg $DISP (autoconfig: fbdev/vesa fallback)"
    Xorg "$DISP" > /tmp/Xorg.log 2>&1 &
    XPID=$!
  fi
fi
# Wait for socket (generous: QEMU TCG is slow)
for i in $(seq 1 30); do
  if [ -S "/tmp/.X11-unix/X${DISP#:}" ]; then break; fi
  if ! kill -0 $XPID 2>/dev/null; then
    echo "[aira-session] X server pid $XPID died early" >&2
    break
  fi
  sleep 1
done
if [ ! -S "/tmp/.X11-unix/X${DISP#:}" ]; then
  echo "aira-session: X socket not ready" >&2
  echo "--- Xvfb/Xorg log ---" >&2
  cat /tmp/Xvfb.log /tmp/Xorg.log 2>/dev/null >&2
  kill $XPID 2>/dev/null
  exit 1
fi
if [ "$USE_XVFB" = "no" ]; then
  echo "[aira-session] visible Xorg display ready on $DISPLAY"
  echo "=== /var/log/Xorg.0.log ===" >&2
  cat /var/log/Xorg.0.log >&2 2>/dev/null
  echo "=== END /var/log/Xorg.0.log ===" >&2
else
  echo "[aira-session] headless Xvfb display ready on $DISPLAY"
  echo "=== Xvfb.log ===" >&2
  cat /tmp/Xvfb.log >&2 2>/dev/null
  echo "=== END Xvfb.log ===" >&2
fi
# Persistent state dirs (survive reboot only under /persist; /tmp is tmpfs).
mkdir -p /persist/var/lib/aira /persist/var/log/airaos /var/log/airaos 2>/dev/null || true
# Notification daemon: queued, non-blocking; fallback to logger when no UI.
# Started before the WM so early session messages are never lost; a second
# instance is harmless (FIFO readers share the queue).
if command -v aira-notifyd >/dev/null 2>&1; then
  if ! pgrep -f "aira-notifyd" >/dev/null 2>&1; then
    aira-notifyd >/var/log/airaos/notifyd.log 2>&1 &
    echo "[aira-session] notifyd started (pid $!)"
  fi
fi
# Wallpaper via the Aira theme engine (falls back to the classic weave).
if command -v aira-wallpaper >/dev/null 2>&1; then
  aira-wallpaper --apply 2>/dev/null || \
    xsetroot -solid "#1d2a6b" 2>/dev/null || true
else
  xsetroot -mod 4 4 -fg "#24338a" -bg "#1d2a6b" 2>/dev/null || \
    xsetroot -solid "#1d2a6b" 2>/dev/null || true
fi
# JWM with Aira config (rootfs at /persist when booted via initramfs).
# The modern top-panel+dock layout is tried first; the 1.5.0 single-tray
# layout (aira-jwmrc.classic) is the supervised fallback so a bad config
# can never leave the session without a window manager.
pick_jwmrc() {
  for c in "/persist/etc/jwm/aira-jwmrc" "/etc/jwm/aira-jwmrc" \
           "/persist/etc/jwm/system.jwmrc" "/etc/jwm/system.jwmrc"; do
    if [ -f "$c" ]; then echo "$c"; return 0; fi
  done
  return 1
}
JWMRC="$(pick_jwmrc)" || { echo "aira-session: no JWM config found" >&2; exit 1; }
JWMRC_CLASSIC="$(dirname "$JWMRC")/aira-jwmrc.classic"
echo "[aira-session] starting jwm ($JWMRC)"
jwm -f "$JWMRC" &
JWM_PID=$!
sleep 1
if ! kill -0 "$JWM_PID" 2>/dev/null; then
  echo "[aira-session] primary JWM config failed, trying classic fallback" >&2
  if [ -f "$JWMRC_CLASSIC" ]; then
    JWMRC="$JWMRC_CLASSIC"
    echo "[aira-session] starting jwm ($JWMRC)"
    jwm -f "$JWMRC" &
    JWM_PID=$!
    sleep 1
  fi
  if ! kill -0 "$JWM_PID" 2>/dev/null; then
    echo "aira-session: JWM failed to start" >&2
    kill $XPID 2>/dev/null
    exit 1
  fi
fi
echo "[aira-session] desktop ready on $DISPLAY (X pid $XPID, jwm $JWM_PID)"
# If interactive (not headless test), wait; else return (test harness manages lifetime)
if [ "$HEADLESS" = "no" ]; then
  wait $JWM_PID 2>/dev/null
  kill $XPID 2>/dev/null
else
  echo "$XPID" > /tmp/aira-X.pid
  echo "$JWM_PID" > /tmp/aira-jwm.pid
fi
