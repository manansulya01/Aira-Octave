#!/bin/sh
# AiraOS Quick Settings — one-glance status + real actions.
# Every row queries/acts on the actual subsystem (audio, network, display,
# theme, session). Rows without an underlying mechanism say so explicitly
# instead of faking a control.
# Usage: aira-quicksettings [--status | --text | --volume up|down|mute|unmute|N |
#        --network renew | --theme next | --session logout|restart|shutdown|reboot]
# NOTE: DISPLAY is intentionally NOT defaulted here. Forcing DISPLAY=:0
# would mask headless detection in --status/--night/--theme delegates.
# Only the --gui branch assumes :0 when DISPLAY is unset.

qs_volume() {
  if command -v aira-audio >/dev/null 2>&1; then
    # aira-audio list shows devices; current level via mixer if present
    lvl="$(aira-audio volume 2>/dev/null | head -n 1)"
    [ -n "$lvl" ] || lvl="(see aira-audio list)"
    printf "Volume: %s\n" "$lvl"
  else
    echo "Volume: aira-audio not installed"
  fi
}

qs_network() {
  if ip -o -4 addr show 2>/dev/null | grep -q .; then
    ip -o -4 addr show 2>/dev/null | awk '{print "Net: " $2 " " $4}' | head -n 3
  else
    echo "Net: no IPv4 addresses"
  fi
  dns="$(grep -m1 nameserver /etc/resolv.conf 2>/dev/null | awk '{print $2}')"
  echo "DNS: ${dns:-not configured}"
}

qs_display() {
  if command -v xrandr >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
    cur="$(xrandr 2>/dev/null | grep -m1 ' connected' )"
    [ -n "$cur" ] || cur="Display: xrandr unavailable"
    echo "Display: $cur" | cut -c1-70
  else
    echo "Display: no X display / xrandr missing"
  fi
}

qs_theme() {
  if command -v aira-theme >/dev/null 2>&1; then
    echo "Theme: $(aira-theme current 2>/dev/null)"
  else
    echo "Theme: aira-theme not installed"
  fi
}

qs_session() {
  echo "User: $(whoami 2>/dev/null)/$(id -un 2>/dev/null)"
  echo "Uptime: $(awk '{printf "%dh %dm", $1/3600, ($1%3600)/60}' /proc/uptime 2>/dev/null)"
}

qs_night() {
  if command -v aira-theme >/dev/null 2>&1; then
    n="$(aira-theme get AIRA_NIGHT 2>/dev/null)"
    [ -n "$n" ] || n="off (default)"
    echo "Night mode: $n"
  else
    echo "Night mode: aira-theme not installed"
  fi
}

qs_battery() {
  if [ -d /sys/class/power_supply ]; then
    bat=""
    for b in /sys/class/power_supply/BAT*; do
      [ -e "$b/capacity" ] || continue
      cap="$(cat "$b/capacity" 2>/dev/null)"
      st="$(cat "$b/status" 2>/dev/null)"
      bat="$bat $(basename "$b"):${cap}%/${st}"
    done
    if [ -n "$bat" ]; then
      echo "Battery:$bat"
      return 0
    fi
    for ac in /sys/class/power_supply/AC* /sys/class/power_supply/ADP*; do
      [ -e "$ac/online" ] || continue
      echo "Battery: no battery, AC online=$(cat "$ac/online" 2>/dev/null)"
      return 0
    done
  fi
  echo "Battery: no battery on this hardware (expected in QEMU)"
}

qs_brightness() {
  for bl in /sys/class/backlight/*; do
    [ -e "$bl/brightness" ] || continue
    cur="$(cat "$bl/brightness" 2>/dev/null)"
    max="$(cat "$bl/max_brightness" 2>/dev/null)"
    echo "Brightness: $cur/$max ($(basename "$bl"))"
    return 0
  done
  echo "Brightness: no backlight control on this hardware"
}

qs_wifi() {
  found=0
  for w in /sys/class/net/wlan* /sys/class/net/wlp*; do
    [ -e "$w" ] || continue
    found=1
    echo "Wi-Fi: $(basename "$w") $(cat "$w/operstate" 2>/dev/null)"
  done
  if [ "$found" = "0" ]; then
    if command -v iw >/dev/null 2>&1 || command -v iwconfig >/dev/null 2>&1; then
      echo "Wi-Fi: tools present, no wireless interface"
    else
      echo "Wi-Fi: Wi-Fi hardware absent (wired/virtio-net only)"
    fi
  fi
}

qs_info() {
  echo "System: $(uname -srm 2>/dev/null) up $(awk '{printf "%dh %dm", $1/3600, ($1%3600)/60}' /proc/uptime 2>/dev/null)"
}

cmd_status() {
  qs_volume; qs_network; qs_wifi; qs_display; qs_battery; qs_brightness; qs_theme; qs_night; qs_session
}

cmd_text() {
  while true; do
    clear
    echo "╔══════════════════════════════════════════════════════════╗"
    echo "║                 Aira Quick Settings                      ║"
    echo "╚══════════════════════════════════════════════════════════╝"
    echo
    cmd_status | sed 's/^/  /'
    echo
    echo "  Actions:"
    echo "    1) Volume up        2) Volume down      3) Mute/unmute"
    echo "    4) Renew DHCP       5) Next theme       6) Next wallpaper"
    echo "    7) Night on         8) Night off        9) Theme select"
    echo "    a) Open Settings    b) Open Network Manager"
    echo "    c) System info      l) Logout           r) Reboot"
    echo "    0) Shutdown         q) Close"
    echo
    printf "  Choice: "
    read choice
    case "$choice" in
      1) "$0" --volume up; printf "  Press Enter..."; read _ ;;
      2) "$0" --volume down; printf "  Press Enter..."; read _ ;;
      3) "$0" --volume mute-toggle; printf "  Press Enter..."; read _ ;;
      4) "$0" --network renew; printf "  Press Enter..."; read _ ;;
      5) aira-theme --next 2>&1; printf "  Press Enter..."; read _ ;;
      6) aira-wallpaper --next 2>&1; printf "  Press Enter..."; read _ ;;
      7) "$0" --night on; printf "  Press Enter..."; read _ ;;
      8) "$0" --night off; printf "  Press Enter..."; read _ ;;
      9)
        echo "  Available themes:"
        aira-theme list 2>/dev/null | sed 's/^/    /'
        printf "  Use theme: "
        read th
        [ -n "$th" ] && aira-theme use "$th" 2>&1
        printf "  Press Enter..."; read _ ;;
      a) aira-settings 2>/dev/null & ;;
      b) aira-netman 2>/dev/null & ;;
      c) qs_info; printf "  Press Enter..."; read _ ;;
      l) aira-session-mgr logout ;;
      r) printf "  Reboot now? [y/N] "; read yn
         [ "$yn" = "y" ] && aira-session-mgr reboot ;;
      0) printf "  Shutdown now? [y/N] "; read yn
         [ "$yn" = "y" ] && aira-session-mgr shutdown ;;
      q|Q) break ;;
    esac
  done
}

cmd_volume() {
  command -v aira-audio >/dev/null 2>&1 || { echo "aira-audio not installed" >&2; return 1; }
  case "${1:-}" in
    up|down)
      cur="$(aira-audio volume 2>/dev/null | grep -o '[0-9]*' | head -n 1)"
      if [ -z "$cur" ]; then
        echo "No mixer available (no audio device)" >&2; return 1
      fi
      if [ "$1" = "up" ]; then new=$((cur + 5)); else new=$((cur - 5)); fi
      [ "$new" -gt 100 ] && new=100
      [ "$new" -lt 0 ] && new=0
      aira-audio volume "$new"
      ;;
    mute) aira-audio mute ;;
    unmute) aira-audio unmute ;;
    mute-toggle)
      if amixer -c "${AIRA_AUDIO_CARD:-0}" get Master 2>/dev/null | grep -q '\[off\]'; then
        aira-audio unmute
      elif amixer -c "${AIRA_AUDIO_CARD:-0}" get Master 2>/dev/null | grep -q '\[on\]'; then
        aira-audio mute
      else
        echo "No mixer available (no audio device)" >&2; return 1
      fi
      ;;
    [0-9]*) aira-audio volume "$1" ;;
    *) echo "Usage: --volume up|down|mute|unmute|N" >&2; return 1 ;;
  esac
}

cmd_network() {
  case "${1:-}" in
    renew)
      for _s in /usr/share/udhcpc/default.script /etc/udhcpc/default.script; do
        if [ -x "$_s" ]; then _SCRIPT="$_s"; break; fi
      done
      iface="$(ip -o link show 2>/dev/null | grep -v -m1 'lo:' | awk -F': ' '{print $2}' | head -n 1)"
      [ -n "$iface" ] || iface="eth0"
      echo "Renewing DHCP on $iface..."
      if [ -n "${_SCRIPT:-}" ]; then
        udhcpc -i "$iface" -n -q -t 3 -s "$_SCRIPT" 2>&1 | head -n 10
      else
        udhcpc -i "$iface" -n -q -t 3 2>&1 | head -n 10
      fi
      ;;
    *) echo "Usage: --network renew" >&2; return 1 ;;
  esac
}

case "${1:---gui}" in
  --status) cmd_status ;;
  --text) cmd_text ;;
  --volume) shift; cmd_volume "$@" ;;
  --network) shift; cmd_network "$@" ;;
  --theme)
    case "${2:-current}" in
      next) aira-theme --next ;;
      list) aira-theme list ;;
      current) aira-theme current ;;
      use)
        if [ -z "${3:-}" ]; then echo "Usage: --theme use NAME" >&2; exit 1; fi
        aira-theme use "$3"
        ;;
      *) echo "Usage: --theme next|list|current|use NAME" >&2; exit 1 ;;
    esac
    ;;
  --night)
    case "${2:-}" in
      on) aira-theme use aira-night && aira-theme set AIRA_NIGHT on ;;
      off) aira-theme use aira-day && aira-theme set AIRA_NIGHT off ;;
      *) echo "Usage: --night on|off" >&2; exit 1 ;;
    esac
    ;;
  --info) qs_info; cmd_status ;;
  --session)
    case "${2:-}" in
      logout|restart|shutdown|reboot) aira-session-mgr "$2" ;;
      *) echo "Usage: --session logout|restart|shutdown|reboot" >&2; exit 1 ;;
    esac
    ;;
  --gui)
    : "${DISPLAY:=:0}"; export DISPLAY
    if command -v xterm >/dev/null 2>&1; then
      # Theme-aware window (single-sourced via aira-theme).
      _QBG="$(aira-theme get AIRA_BG 2>/dev/null)"; [ -n "$_QBG" ] || _QBG="#0b1026"
      _QFG="$(aira-theme get AIRA_FG 2>/dev/null)"; [ -n "$_QFG" ] || _QFG="#e8ecff"
      exec xterm \
        -fa "Monospace" -fs 10 \
        -bg "$_QBG" -fg "$_QFG" \
        -sb -sl 200 \
        -T "Aira Quick Settings" \
        -geometry 60x30+300+60 \
        -name aira-quicksettings \
        -e "$0" --text
      exit 0
    fi
    cmd_text
    ;;
  -h|--help|help)
    echo "Usage: aira-quicksettings [--status|--text|--volume ..|--network renew|--theme next|--session ..]" ;;
  *) echo "aira-quicksettings: unknown option '$1'" >&2; exit 1 ;;
esac
