#!/bin/sh
# Headless GUI smoke test (runs INSIDE guest): Xvfb + jwm + 5 apps, no crash.
# Prints GUI-TEST markers. Exit 0 pass, 1 fail. Kills X afterwards.
export PATH=/persist/usr/bin:/persist/bin:/persist/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LD_LIBRARY_PATH=/persist/usr/lib/x86_64-linux-gnu:/persist/lib/x86_64-linux-gnu:/persist/usr/lib:/persist/lib:$LD_LIBRARY_PATH
export DISPLAY=":99"
PASS=1
rm -f /tmp/.X99-lock /tmp/aira-gui-shot.xwd 2>/dev/null
echo "===== GUI TEST START ====="
command -v Xvfb >/dev/null 2>&1 || { echo "GUI-TEST FAIL: Xvfb missing (PATH=$PATH)"; ls -l /persist/usr/bin/Xvfb 2>&1; exit 1; }
command -v jwm >/dev/null 2>&1 || { echo "GUI-TEST FAIL: jwm missing"; exit 1; }
echo "--- env diagnostics ---"
ls -l /lib64 /lib 2>&1 | head
ls /dev/shm 2>&1
Xvfb -help 2>&1 | head -n 5 || echo "DIAG: Xvfb -help failed rc=$?"
echo "--- foreground Xvfb trial (:98) ---"
timeout 5 Xvfb :98 -screen 0 800x600x16 -fp /persist/usr/share/fonts/X11/misc -xkbdir /persist/usr/share/X11/xkb 2>&1 &
TRIAL=$!
sleep 3
ls -l /tmp/.X11-unix/ 2>&1
kill $TRIAL 2>/dev/null
wait $TRIAL 2>/dev/null
echo "trial rc=$?"
if [ -x /persist/usr/bin/aira-session ]; then SES=/persist/usr/bin/aira-session; else SES=/usr/bin/aira-session; fi
sh "$SES" --headless --display :99 || { echo "GUI-TEST FAIL: session failed"; exit 1; }
sleep 1
xwininfo -root 2>/dev/null | head -n 10 || { echo "GUI-TEST FAIL: xwininfo root"; PASS=0; }
echo "--- launching apps ---"
xterm -T "AiraTest-Term" -e sh -c 'sleep 90' &
TPID=$!
mkdir -p /persist/screenshots 2>/dev/null || true
# Graphical popup (contributes a real xmessage window) + deterministic stdout
# capture. The popup runs in background; content is verified synchronously
# below so slow IPC under TCG load cannot race the check.
sh "$(command -v aira-sysinfo)" >/dev/null 2>&1 &
SYSMSG_PID=$!
sh "$(command -v aira-about)" >/tmp/gui-about.log 2>&1 &
APID=$!
# synchronous content probe (no xmessage, bounded time)
timeout 60 sh "$(command -v aira-sysinfo)" --once >/tmp/gui-sysinfo.log 2>&1 || echo "GUI-TEST INFO: sysinfo --once rc=$? (content check below)"
aira-sysmon --once > /tmp/gui-sysmon.log 2>&1 && grep -qi "cpu\|mem" /tmp/gui-sysmon.log && echo "GUI-TEST OK: sysmon data" || { echo "GUI-TEST FAIL: sysmon"; PASS=0; }
aira-netman --once > /tmp/gui-netman.log 2>&1 && grep -qi "interface\|address" /tmp/gui-netman.log && echo "GUI-TEST OK: netman data" || { echo "GUI-TEST FAIL: netman"; PASS=0; }
DISPLAY=:99 mc --version >/tmp/gui-mc.log 2>&1 && echo "GUI-TEST OK: mc present" || { echo "GUI-TEST FAIL: mc"; PASS=0; }
timeout 90 aira-textedit &
TEPID=$!
timeout 90 aira-pkgcenter &
PCPID=$!
timeout 90 aira-netman &
NMPID=$!
echo "--- waiting for app windows (poll up to 60s) ---"
i=0
while [ "$i" -lt 30 ]; do
  xwininfo -root -children 2>/dev/null > /tmp/gui-windows.log
  # count mapped client windows (exclude 1x1 JWM frame and 1024x28 tray)
  n=$(grep -c "0x[0-9a-f]* (" /tmp/gui-windows.log 2>/dev/null || echo 0)
  if [ "$n" -ge 5 ]; then
    echo "app windows mapped: $n children after ${i}x2s"; break
  fi
  sleep 2
  i=$((i+1))
done
xlsclients 2>/dev/null | tee /tmp/gui-clients.log
head -n 60 /tmp/gui-windows.log
echo "--- log sizes ---"
wc -c /tmp/gui-sysinfo.log /tmp/gui-about.log /tmp/gui-sysmon.log 2>&1
head -n 5 /tmp/gui-sysinfo.log 2>&1
head -n 5 /tmp/gui-about.log 2>&1
n=$(grep -c "0x[0-9a-f]* (" /tmp/gui-windows.log 2>/dev/null || echo 0)
if [ "$n" -ge 5 ]; then echo "GUI-TEST OK: $n client windows mapped (terminal+editor+pkgcenter+dialogs)";
else echo "GUI-TEST FAIL: only $n windows (need >=5)"; PASS=0; fi
grep -qi "AiraTest-Term\|Editor\|Package" /tmp/gui-windows.log && echo "GUI-TEST OK: named app window present" || echo "GUI-TEST INFO: titles not yet set (slow TCG, non-fatal)"
grep -qi "xterm\|xmessage" /tmp/gui-clients.log && echo "GUI-TEST OK: xterm/xmessage clients" || echo "GUI-TEST INFO: xlsclients empty (non-fatal)"
grep -qi "airaos-octave\|memtotal" /tmp/gui-sysinfo.log && echo "GUI-TEST OK: sysinfo content" || { echo "GUI-TEST FAIL: sysinfo content"; PASS=0; }
grep -qi "airaos-octave" /tmp/gui-about.log && echo "GUI-TEST OK: about content" || { echo "GUI-TEST FAIL: about content"; PASS=0; }
xwd -root -out /tmp/aira-gui-shot.xwd 2>/dev/null && echo "GUI-TEST OK: screenshot $(wc -c < /tmp/aira-gui-shot.xwd) bytes" || echo "GUI-TEST INFO: xwd failed (non-fatal)"
cp -f /tmp/aira-gui-shot.xwd /persist/screenshots/ 2>/dev/null || true
kill $TPID $APID $TEPID $PCPID $NMPID ${SYSMSG_PID:-} 2>/dev/null
# desktop must survive app exit
sleep 1
ps 2>/dev/null | grep -i jwm 2>/dev/null | head -n 5
if pidof jwm >/dev/null 2>&1; then echo "GUI-TEST OK: desktop survives apps (pidof)";
elif ps 2>/dev/null | grep -q "[j]wm"; then echo "GUI-TEST OK: desktop survives apps (ps)";
else echo "GUI-TEST FAIL: jwm died"; pidof jwm 2>&1; echo "--- full ps ---"; ps 2>/dev/null | tail -n 30; PASS=0; fi
# cleanup X
[ -f /tmp/aira-X.pid ] && kill "$(cat /tmp/aira-X.pid)" 2>/dev/null
[ -f /tmp/aira-jwm.pid ] && kill "$(cat /tmp/aira-jwm.pid)" 2>/dev/null
pkill Xvfb 2>/dev/null; pkill jwm 2>/dev/null
sleep 0.5
if [ "$PASS" = "1" ]; then echo "===== GUI TEST PASS ====="; exit 0;
else echo "===== GUI TEST FAIL ====="; exit 1; fi
