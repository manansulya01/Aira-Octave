#!/bin/sh
# AiraOS notify-send compatible notification sender.
# Usage: aira-notify [--urgency=low|normal|critical] [--expire-time=ms] <title> [<message>]
#        aira-notify --history [N] | --clear
# Sends never block the caller (background FIFO write). History is kept by
# aira-notifyd in /var/log/airaos/notifications.log.

NOTIFY_FIFO="${AIRA_NOTIFY_FIFO:-/tmp/aira-notify-fifo}"
HIST_LOG="${AIRA_NOTIFY_LOG:-/var/log/airaos/notifications.log}"
URGENCY="normal"
TIMEOUT=5000

while [ $# -gt 0 ]; do
    case "$1" in
        --urgency=*)
            URGENCY="${1#--urgency=}"
            shift
            ;;
        --expire-time=*)
            TIMEOUT="${1#--expire-time=}"
            shift
            ;;
        -u)
            URGENCY="$2"
            shift 2
            ;;
        -t)
            TIMEOUT="$2"
            shift 2
            ;;
        --history)
            N="${2:-10}"
            case "$N" in *[!0-9]*|"") N=10 ;; esac
            if [ -f "$HIST_LOG" ]; then
                tail -n "$N" "$HIST_LOG" 2>/dev/null
            else
                echo "(no notification history yet)"
            fi
            exit 0
            ;;
        --clear)
            : > "$HIST_LOG" 2>/dev/null && echo "Notification history cleared" || echo "Cannot clear $HIST_LOG" >&2
            exit 0
            ;;
        -h|--help|help)
            echo "Usage: aira-notify [--urgency=..] [--expire-time=ms] <title> [message] | --history [N] | --clear"
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

TITLE="${1:-Notification}"
MESSAGE="${2:-}"

# Ensure FIFO exists
[ -p "$NOTIFY_FIFO" ] || mkfifo "$NOTIFY_FIFO" 2>/dev/null

# Send notification (timeout in seconds for xmessage)
TIMEOUT_SEC=$((TIMEOUT / 1000))
[ "$TIMEOUT_SEC" -lt 1 ] && TIMEOUT_SEC=1

echo "$URGENCY|$TITLE|$MESSAGE|$TIMEOUT_SEC" > "$NOTIFY_FIFO" 2>/dev/null &