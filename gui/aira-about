#!/bin/sh
# About AiraOS-Octave (real version from /etc/os-release + live kernel facts).
VER="$(grep '^VERSION=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '\"')"
[ -n "$VER" ] || VER="1.2.0"
MSG="AiraOS-Octave $VER

$(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '\"')
Version: $VER
Kernel: Linux $(uname -r 2>/dev/null)
Architecture: $(uname -m 2>/dev/null)

AiraOS-Octave is a small bootable x86_64 operating system:
Linux kernel plus the Aira userspace with supervised
services, a local IPC service bus, persistent storage,
a package manager, and this JWM graphical desktop."
echo "$MSG"
if [ -n "${DISPLAY:-}" ] && command -v xmessage >/dev/null 2>&1; then
  echo "$MSG" | xmessage -file - -buttons OK:0 -title "About AiraOS-Octave" 2>/dev/null
fi
