#!/bin/sh
# About AiraOS-Octave - shows version, kernel, architecture, and system info.
# Uses xmessage for graphical display, stdout for text.

VER="$(grep '^VERSION=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '\"')"
[ -n "$VER" ] || VER="1.5.0"

MSG="AiraOS-Octave $VER

$(grep PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '\"')
Version: $VER
Kernel: Linux $(uname -r 2>/dev/null)
Architecture: $(uname -m 2>/dev/null)

AiraOS-Octave is a small bootable x86_64 operating system:
Linux kernel plus the Aira userspace with supervised
services, a local IPC service bus, persistent storage,
a package manager, and this JWM graphical desktop.

Built with: Linux $(uname -r 2>/dev/null | cut -d- -f1)
Boot time: $(awk '{d=int($1/86400);h=int(($1%86400)/3600);m=int(($1%3600)/60);printf "%dd %02d:%02d",d,h,m}' /proc/uptime 2>/dev/null)
Memory: $(awk '/MemTotal/{printf "%d MB",$2/1024}' /proc/meminfo 2>/dev/null)
Storage: $(if grep -q ' /persist ' /proc/mounts 2>/dev/null; then df -h /persist 2>/dev/null | awk 'NR==2{print $2" ("$5" used)"}'; else echo 'RAM only (boot with -drive for persistence)'; fi)

Copyright (C) 2024-2025 AiraOS Project
Licensed under MIT License"

echo "$MSG"

if [ -n "${DISPLAY:-}" ] && command -v xmessage >/dev/null 2>&1; then
    echo "$MSG" | xmessage -file - -buttons OK:0 -title "About AiraOS-Octave" -center 2>/dev/null
fi