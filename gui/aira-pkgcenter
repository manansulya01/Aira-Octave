#!/bin/sh
# AiraOS Package Center - GUI frontend for airapkg with search, info, install, remove, update.
export DISPLAY="${DISPLAY:-:0}"

if [ "${1:-}" = "--text" ]; then
    # Text mode for xterm
    while true; do
        clear
        echo "╔═════════════════════════════════════════════════════════════════════════════╗"
        echo "║                        AiraOS Package Center                                ║"
        echo "╚═════════════════════════════════════════════════════════════════════════════╝"
        echo
        echo "Installed packages:"
        airapkg list 2>/dev/null | while IFS= read -r pkg; do
            echo "  $pkg"
        done
        if ! airapkg list 2>/dev/null | grep -q .; then
            echo "  (none)"
        fi
        echo
        echo "Repository: /var/lib/airapkg/repo"
        ls -1 /var/lib/airapkg/repo/*.apkg 2>/dev/null | while IFS= read -r pkg; do
            echo "  $(basename "$pkg")"
        done
        if ! ls /var/lib/airapkg/repo/*.apkg 2>/dev/null | grep -q .; then
            echo "  (empty)"
        fi
        echo
        echo "Actions:"
        echo "  1) Search packages          2) Package info"
        echo "  3) Install .apkg file       4) Remove package"
        echo "  5) Update check             6) Verify package"
        echo "  7) Rollback package         q) Quit"
        echo
        printf "Choice: "
        read choice
        case "$choice" in
            1)
                printf "Search term: "
                read term
                echo "--- Searching installed ---"
                airapkg search "$term" 2>&1 | head -n 20
                printf "Press Enter..."; read _
                ;;
            2)
                printf "Package name: "
                read name
                airapkg info "$name" 2>&1 | head -n 40
                printf "Press Enter..."; read _
                ;;
            3)
                printf "Path to .apkg file: "
                read path
                airapkg install "$path" 2>&1 | head -n 20
                printf "Press Enter..."; read _
                ;;
            4)
                printf "Package name to remove: "
                read name
                airapkg remove "$name" 2>&1
                printf "Press Enter..."; read _
                ;;
            5)
                airapkg update-check 2>&1 | head -n 20
                printf "Press Enter..."; read _
                ;;
            6)
                printf "Package name to verify: "
                read name
                airapkg verify "$name" 2>&1
                printf "Press Enter..."; read _
                ;;
            7)
                printf "Package name to rollback: "
                read name
                airapkg rollback "$name" 2>&1
                printf "Press Enter..."; read _
                ;;
            q|Q) break ;;
        esac
    done
    exit 0
fi

# Graphical mode (theme single-sourced).
if [ -n "${DISPLAY:-}" ] && command -v xterm >/dev/null 2>&1; then
    _PBG="$(aira-theme get AIRA_BG 2>/dev/null)"; [ -n "$_PBG" ] || _PBG="#0b1026"
    _PFG="$(aira-theme get AIRA_FG 2>/dev/null)"; [ -n "$_PFG" ] || _PFG="#e8ecff"
    exec xterm \
        -fa "Monospace" -fs 10 \
        -bg "$_PBG" -fg "$_PFG" \
        -sb -sl 1000 \
        -T "AiraOS Package Center" \
        -geometry 90x38+240+150 \
        -name aira-pkgcenter \
        -e "$0" --text
else
    "$0" --text
fi