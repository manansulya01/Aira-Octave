#!/bin/sh
# system — read-only system facts over the Aira IPC bus.
# Methods: info | version | uptime | memory
m="$1"; a="${2:-}"
case "$m" in
  info)
    echo "os=$(cat /etc/os-release 2>/dev/null | grep ^PRETTY_NAME= | cut -d= -f2 | tr -d '\"' | tr ' ' '_')"
    uname -a | tr ' ' '_'
    ;;
  version)
    grep ^VERSION= /etc/os-release 2>/dev/null | head -n 1 || echo 'VERSION="unknown"'
    ;;
  uptime) cat /proc/uptime 2>/dev/null || echo "unknown" ;;
  memory) grep -E "MemTotal|MemFree|MemAvailable" /proc/meminfo 2>/dev/null | tr '\n' ';' ;;
  *) echo "unknown method: $m (want info|version|uptime|memory)"; exit 3 ;;
esac
