#!/bin/sh
# services — service state over the Aira IPC bus.
# Methods: status (read-only, open) | start|stop|restart (PRIVILEGED: root token).
# Single-service target only: args = "<name>".
PRIV_METHODS="start stop restart"
INIT="${AIRA_INIT:-/sbin/aira-init}"
m="$1"; a="${2:-}"
case "$m" in
  status)
    if [ -n "$a" ]; then
      case "$a" in *[!a-z0-9_-]*) echo "bad service name"; exit 3 ;; esac
      $INIT status "$a" 2>&1
    else
      $INIT status 2>&1
    fi | tr '\n' ';'
    ;;
  start|stop|restart)
    name="$(printf "%s" "$a" | awk '{print $1}')"
    [ -n "$name" ] || { echo "need service name"; exit 3; }
    case "$name" in *[!a-z0-9_-]*) echo "bad service name"; exit 3 ;; esac
    $INIT "$m" "$name" 2>&1 | tr '\n' ';'
    ;;
  *) echo "unknown method: $m (want status|start|stop|restart)"; exit 3 ;;
esac
