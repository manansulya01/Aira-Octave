#!/bin/sh
# aira — AiraOS-Octave system command (real operations only).
set -u
VER="1.5.0"
usage() {
  cat <<'EOF'
aira — AiraOS-Octave system command
  aira help                  this help
  aira info                  OS/kernel/arch
  aira version               AiraOS version
  aira system                kernel+cpu+mem+disk summary
  aira status                services + key mounts (via IPC when available)
  aira services [args]       service start|stop|restart|status|enable|disable|logs|diag
  aira service <args>        alias for services
  aira network [dhcp IF]     interfaces/routes/dns (+ renew DHCP)
  aira platform              cpu/smp/pci/virtio/input/graphics
  aira storage               disks/mounts/usage/persist status
  aira users                 users/groups/ownership
  aira user <cmd> [args]     user management (add/del/passwd/groups/login)
  aira packages [args]       package list|search|info|install/remove/verify/rollback
  aira package <args>        alias for packages
  aira device <cmd> [args]   device management (list/pci/usb/input/virtio/block/net)
  aira diagnose              full diagnostic dump
  aira doctor                health check via IPC bus + direct probes
  aira recovery [check|fix] [component]  system recovery
  aira hardening             apply security hardening
  aira ipc <args>            IPC bus client (ping|list|call|emit|events)
  aira demo                  guided live demo (real system data)
  aira shutdown [--force]    power off (needs --force)
  aira reboot [--force]      reboot (needs --force)
  aira update --check        show version (safe, no self-modify)
EOF
}
cmd="${1:-help}"
case "$cmd" in
  help|--help|-h) usage ;;
  info)
    [ -f /etc/os-release ] && cat /etc/os-release
    uname -a
    ;;
  version) echo "AiraOS-Octave $VER ($(uname -m))" ;;
  system)
    echo "== OS =="; cat /etc/os-release 2>/dev/null || echo "(no os-release)"
    echo "== kernel =="; uname -a
    echo "== cpu =="; grep -m1 "model name" /proc/cpuinfo 2>/dev/null || echo "(no cpuinfo)"
    echo "== mem =="; grep -E "MemTotal|MemFree|MemAvailable" /proc/meminfo 2>/dev/null
    echo "== disk =="; df -h 2>/dev/null | head -n 10
    echo "== uptime =="; uptime 2>/dev/null || cat /proc/uptime 2>/dev/null
    ;;
  status)
    echo "== mounts =="; mount 2>/dev/null | head -n 20
    # Prefer IPC bus for service truth when the daemon is alive (real integration);
    # fall back to direct aira-init so status never depends on IPC alone.
    if command -v aira-ipc >/dev/null 2>&1 && aira-ipc ping >/dev/null 2>&1; then
      echo "== services (via IPC bus) =="; aira-ipc call services status 2>&1 | tr ';' '\n' || /sbin/aira-init status 2>&1
    else
      echo "== services =="; /sbin/aira-init status 2>&1 || echo "(aira-init unavailable)"
    fi
    ;;
  service|services)
    shift || true
    /sbin/aira-init "$@" ;;
  network)
    shift || true
    if [ "${1:-}" = "dhcp" ]; then
      iface="${2:-eth0}"
      echo "renewing DHCP on $iface..."
      for _s in /usr/share/udhcpc/default.script /etc/udhcpc/default.script; do
        if [ -x "$_s" ]; then _SCRIPT="$_s"; break; fi
      done
      if [ -n "${_SCRIPT:-}" ]; then
        udhcpc -i "$iface" -n -q -t 3 -s "$_SCRIPT" 2>&1 | head -n 20 || echo "(DHCP failed/unsupported here)"
      else
        udhcpc -i "$iface" -n -q -t 3 2>&1 | head -n 20 || echo "(DHCP failed/unsupported here)"
      fi
      exit 0
    fi
    echo "== hostname =="; hostname; cat /etc/hostname 2>/dev/null
    echo "== interfaces =="; ip addr 2>/dev/null || ifconfig 2>/dev/null || echo "(no ip/ifconfig)"
    echo "== routes =="; ip route 2>/dev/null || route -n 2>/dev/null || echo "(no route info)"
    echo "== dns =="; cat /etc/resolv.conf 2>/dev/null || echo "(no /etc/resolv.conf)"
    echo "== ping loopback =="; ping -c1 -W2 127.0.0.1 2>&1 | tail -n 5 || echo "(ping failed)"
    ;;
  storage)
    echo "== disks =="; ls -l /dev/vd* /dev/sd* /dev/sr* 2>/dev/null || echo "(no virtio/scsi disks)"
    echo "== filesystems =="; df -h 2>/dev/null
    echo "== mounts =="; mount 2>/dev/null | grep -E "persist|vda|root" || mount 2>/dev/null | head -n 10
    if [ -d /persist ] && mount 2>/dev/null | grep -q " /persist "; then
      echo "== persist == OK (/persist mounted)"; df -h /persist 2>/dev/null
    else
      echo "== persist == NOT AVAILABLE (boot with -drive aira-rootfs.img for persistence)"
    fi
    ;;
  users)
    echo "== users =="; cat /etc/passwd 2>/dev/null
    echo "== groups =="; cat /etc/group 2>/dev/null
    echo "== home =="; ls -ld /root /home/* 2>/dev/null
    echo "== identity =="; id 2>/dev/null; whoami 2>/dev/null
    ;;
  package|packages)
    shift || true
    exec airapkg "$@" ;;
  diagnose)
    echo "===== AIRA DIAGNOSE $VER $(date -u 2>/dev/null) ====="
    echo "--- os ---"; cat /etc/os-release 2>/dev/null
    echo "--- kernel ---"; uname -a; dmesg 2>/dev/null | tail -n 20
    echo "--- cpu ---"; grep -m2 "model name\|cpu MHz" /proc/cpuinfo 2>/dev/null
    echo "--- mem ---"; free -h 2>/dev/null || cat /proc/meminfo 2>/dev/null | head
    echo "--- disks ---"; df -h 2>/dev/null; ls -l /dev/vd* /dev/sd* 2>/dev/null || echo "(no block devs)"
    echo "--- mounts ---"; mount 2>/dev/null
    echo "--- net ---"; ip addr 2>/dev/null | head -n 30
    echo "--- services ---"; /sbin/aira-init status 2>&1
    echo "--- ipc ---"
    if command -v aira-ipc >/dev/null 2>&1 && aira-ipc ping >/dev/null 2>&1; then
      echo "bus: alive"; aira-ipc list 2>&1 | head -n 10
    else
      echo "bus: unreachable (aira-ipcd not running?)"
    fi
    echo "--- users ---"; cat /etc/passwd 2>/dev/null
    echo "--- graphics ---"; ls -l /dev/dri /dev/fb0 2>&1; dmesg 2>/dev/null | grep -i -E "drm|vga|virtio.*gpu|fb" | head
    echo "--- boot ---"; tail -n 30 /var/log/airaos/boot.log 2>/dev/null || echo "(no boot.log)"
    echo "===== END DIAGNOSE ====="
    ;;
  doctor)
    # Real health check: probes kernel, services, IPC, storage, network directly.
    # Exit 0 only if core checks pass; prints PASS/FAIL per area (never fakes).
    _fail=0
    echo "===== AIRA DOCTOR $VER ====="
    if grep -q "Linux version" /proc/version 2>/dev/null || uname -a 2>/dev/null | grep -q Linux; then echo "kernel: PASS ($(uname -r 2>/dev/null))"; else echo "kernel: FAIL"; _fail=1; fi
    if [ -f /etc/os-release ] && grep -q AiraOS-Octave /etc/os-release 2>/dev/null; then echo "userspace: PASS"; else echo "userspace: FAIL"; _fail=1; fi
    if /sbin/aira-init status syslog 2>/dev/null | grep -q running; then echo "services(syslog): PASS"; else echo "services(syslog): FAIL"; _fail=1; fi
    if command -v aira-ipc >/dev/null 2>&1 && aira-ipc ping >/dev/null 2>&1; then
      echo "ipc(bus ping): PASS"
      if aira-ipc call system version >/dev/null 2>&1; then echo "ipc(system): PASS"; else echo "ipc(system): FAIL"; _fail=1; fi
      if aira-ipc call storage persist >/dev/null 2>&1; then echo "ipc(storage): PASS"; else echo "ipc(storage): FAIL"; _fail=1; fi
      if aira-ipc call network interfaces >/dev/null 2>&1; then echo "ipc(network): PASS"; else echo "ipc(network): FAIL"; _fail=1; fi
      if aira-ipc call services status >/dev/null 2>&1; then echo "ipc(services): PASS"; else echo "ipc(services): FAIL"; _fail=1; fi
      if aira-ipc call device list >/dev/null 2>&1; then echo "ipc(device): PASS"; else echo "ipc(device): FAIL"; _fail=1; fi
      if aira-ipc call user list >/dev/null 2>&1; then echo "ipc(user): PASS"; else echo "ipc(user): FAIL"; _fail=1; fi
    else
      echo "ipc(bus ping): FAIL (aira-ipcd unreachable)"; _fail=1
    fi
    if df >/dev/null 2>&1; then echo "storage(df): PASS"; else echo "storage(df): FAIL"; _fail=1; fi
    if ping -c1 -W2 127.0.0.1 >/dev/null 2>&1; then echo "network(loopback): PASS"; else echo "network(loopback): FAIL"; _fail=1; fi
    if [ -f /etc/passwd ] && grep -q "^aira:" /etc/passwd 2>/dev/null; then echo "security(users): PASS"; else echo "security(users): FAIL"; _fail=1; fi
    if [ -f /etc/shadow ]; then echo "security(shadow): PASS"; else echo "security(shadow): FAIL"; _fail=1; fi
    if [ -d /sys/fs/cgroup ]; then echo "security(cgroups): PASS"; else echo "security(cgroups): FAIL"; _fail=1; fi
    if grep -q "CONFIG_SECCOMP=y" /proc/config.gz 2>/dev/null || grep -q "CONFIG_SECCOMP=y" /boot/config-* 2>/dev/null; then echo "security(seccomp): PASS"; else echo "security(seccomp): UNKNOWN"; fi
    if [ "$_fail" = "0" ]; then echo "===== DOCTOR PASS ====="; exit 0; else echo "===== DOCTOR FAIL ====="; exit 1; fi
    ;;
  ipc)
    shift || true
    exec aira-ipc "$@" ;;
  demo) exec /usr/bin/aira-demo ;;
  platform)
    echo "== cpu =="; grep -E "model name|cpu MHz" /proc/cpuinfo 2>/dev/null | head -n 4
    echo "CPUs: $(grep -c '^processor' /proc/cpuinfo 2>/dev/null)"
    echo "== interrupts =="; head -n 12 /proc/interrupts 2>/dev/null || echo "(no /proc/interrupts)"
    echo "== pci =="
    if [ -d /sys/bus/pci/devices ]; then
      for d in /sys/bus/pci/devices/*; do
        [ -e "$d/vendor" ] || continue
        printf "%s vendor=%s device=%s class=%s\n" "$(basename "$d")" "$(cat "$d/vendor" 2>/dev/null)" "$(cat "$d/device" 2>/dev/null)" "$(cat "$d/class" 2>/dev/null)"
      done 2>/dev/null | head -n 20
    else
      dmesg 2>/dev/null | grep -i pci | head -n 10
    fi
    echo "== virtio =="; dmesg 2>/dev/null | grep -i virtio | head -n 10
    echo "== input =="; dmesg 2>/dev/null | grep -iE "i8042|input:" | head -n 8
    echo "== drm/fb =="; ls -l /dev/dri /dev/fb0 2>&1 || echo "(no DRM/fbdev on this boot path; use --gpu virtio)"
    exit 0
    ;;
  user)
    shift || true
    exec /usr/bin/aira-user "$@" ;;
  device)
    shift || true
    if command -v aira-ipc >/dev/null 2>&1 && aira-ipc ping >/dev/null 2>&1; then
        aira-ipc call device "$@" 2>&1 | tr ';' '\n'
    else
        echo "IPC bus not available, running direct..."
        /usr/bin/aira-device-setup
    fi
    ;;
  recovery)
    shift || true
    exec /sbin/aira-recovery "$@" ;;
  hardening)
    exec /sbin/aira-hardening ;;
  shutdown)
    if [ "${2:-}" = "--force" ]; then echo "stopping services..."; /sbin/aira-init shutdown 2>&1; sync; echo "shutting down..."; poweroff -f
    else echo "usage: aira shutdown --force" >&2; exit 2; fi ;;
  reboot)
    if [ "${2:-}" = "--force" ]; then echo "stopping services..."; /sbin/aira-init shutdown 2>&1; sync; echo "rebooting..."; reboot -f
    else echo "usage: aira reboot --force" >&2; exit 2; fi ;;
  update)
    echo "AiraOS-Octave $VER — update --check only in v1 (no self-modifying updater)."
    echo "To update: rebuild via scripts/build-*.sh, verify test-all.sh, reinstall image."
    ;;
  *) echo "unknown: $cmd (try: aira help)" >&2; exit 2 ;;
esac
