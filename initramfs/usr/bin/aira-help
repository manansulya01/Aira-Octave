#!/bin/sh
# AiraOS Help Viewer - built-in help system for users.
# Shows documentation for system commands and applications.

HELP_DIR="${AIRA_HELP_DIR:-/usr/share/aira/help}"
_HELP_TMP=0
if ! mkdir -p "$HELP_DIR" 2>/dev/null || ! touch "$HELP_DIR/.w" 2>/dev/null; then
    # Host/non-root fallback (also keeps guest tmpfs writes off the index
    # when /usr is read-only): per-process cache under TMPDIR.
    HELP_DIR="${TMPDIR:-/tmp}/aira-help-$$"
    mkdir -p "$HELP_DIR" 2>/dev/null
    _HELP_TMP=1
fi
rm -f "$HELP_DIR/.w" 2>/dev/null
if [ "$_HELP_TMP" = "1" ]; then
    # Clean only the fallback dir we just created (never the system path):
    # it holds nothing but our generated index.
    trap 'rm -rf "$HELP_DIR" 2>/dev/null' EXIT HUP INT TERM
fi

# Generate help content if not exists
if [ ! -f "$HELP_DIR/index.txt" ]; then
    cat > "$HELP_DIR/index.txt" <<'HELPEOF'
AiraOS-Octave Help System
=========================

MAIN COMMANDS
-------------
aira help              - This help system
aira info              - OS/kernel/architecture info
aira version           - AiraOS version
aira system            - Kernel + CPU + memory + disk summary
aira status            - Services + key mounts (via IPC when available)
aira services          - Service management (start/stop/restart/status/enable/disable)
aira network           - Network interfaces, routes, DNS (+ DHCP renew)
aira platform          - CPU/SMP/PCI/VirtIO/input/graphics
aira storage           - Disks, mounts, usage, persistence status
aira users             - Users, groups, ownership
aira packages          - Package management (list/search/info/install/remove)
aira diagnose          - Full diagnostic dump
aira doctor            - Health check via IPC bus + direct probes
aira ipc               - IPC bus client (ping/list/call/emit/events)
aira demo              - Guided live demo (real system data)
aira shutdown --force  - Power off
aira reboot --force    - Reboot
aira update --check    - Show version (no self-modify)

BUILT-IN APPLICATIONS
---------------------
Terminal (Alt+F2)     - Command-line shell with copy/paste
Files (Alt+F3)        - Graphical file manager (Midnight Commander)
Editor (menu/Alt+F11) - Text editor (vi with Aira config)
Settings (Alt+F5)     - System configuration (system/display/network/storage/users/security/apps/about)
Monitor (Alt+F6)      - Real-time CPU/memory/process/storage/network
Network (Alt+F7)      - Network interfaces, DHCP, routes, DNS
Packages (Alt+F8)     - Package center (search/info/install/remove/update/verify/rollback)
About (Alt+F9)        - System information and version

KEYBOARD SHORTCUTS
------------------
Alt+F1                - Main menu (or Ctrl+Esc)
Alt+F2                - Terminal
Alt+F3                - File Manager
Alt+F4                - Close active window
Alt+F5                - Settings
Alt+F6                - System Monitor
Alt+F7                - Network Manager
Alt+F8                - Package Center
Alt+F9                - About
Alt+F10               - Quick Settings
Alt+F11               - Application Launcher
Alt+Tab               - Switch between windows
Right-click desktop   - Application menu

FILE MANAGER (mc) KEYS
----------------------
F1  Help              F2  Save/Menu       F3  View            F4  Edit
F5  Copy              F6  Move/Rename     F7  New Folder      F8  Delete
F9  Menu              F10 Quit            Tab  Switch panels  Enter Open
Ctrl+O  Toggle shell  Ctrl+X  Quick cd    Ctrl+V  View        Ctrl+U  Swap panels

EDITOR (vi) KEYS
----------------
i  Insert mode        ESC Normal mode     :w  Save            :q  Quit
:wq Save & quit       :q! Force quit      /text Search        n Next match
yy Yank line          p  Paste            u  Undo             Ctrl+r Redo
F2  Save (mapped)     F3  Save as         F4  Quit            F5  Toggle paste

SYSTEM CONCEPTS
---------------
Persistence: Boot with -drive aira-rootfs.img to save changes to disk.
             Without it, all changes are lost on reboot.

Services: Managed by aira-init (boot/shutdown/start/stop/restart/status/enable/disable).
          Core services: syslog, klog, net, persist, ipc.

IPC Bus: Local service bus (AIRA1 protocol) on 127.0.0.1:41234.
         Services: bus, device, files, network, services, settings,
                   storage, sysstat, system, terms, user.
         Use: aira ipc call <service> <method> [args]

Packages: Local .apkg format (gzipped tar with PKGINFO).
          Repo at /var/lib/airapkg/repo/, DB at /var/lib/airapkg/installed/.
          Commands: airapkg list/search/info/install/remove/verify/rollback/build/update-check

Security: Runs as root in current version (single-user).
          IPC privileged methods require root token.
          Package manager validates paths, rejects symlinks/traversal.

TROUBLESHOOTING
---------------
No network?      → Settings → Renew DHCP, or: aira network dhcp eth0
No GUI?          → Check Xorg/Xvfb: aira-session --xorg or --xvfb
No persistence?  → Boot with QEMU: -drive file=aira-rootfs.img,format=raw
Package failed?  → Check /var/log/airaos/airapkg.log, use airapkg verify
Services down?   → aira status, aira-init status, check /var/log/airaos/*.log

GETTING MORE HELP
-----------------
aira diagnose      - Full system state dump
aira doctor        - Quick health check
/var/log/airaos/   - All system logs
aira demo          - Interactive system tour

DOCUMENTATION (shipped in /usr/share/doc/aira-octave)
-----------------------------------------------------
aira-help docs            - List shipped documents
aira-help docs <name.md>  - Print a document
Highlights: ARCHITECTURE.md, USER_GUIDE.md, TESTING.md,
            SECURITY.md, TROUBLESHOOTING.md, PACKAGE_MANAGEMENT.md,
            CAPABILITY-MATRIX.md
HELPEOF
fi

# Display help
if [ $# -eq 0 ]; then
    # Show index
    cat "$HELP_DIR/index.txt" | less -R 2>/dev/null || cat "$HELP_DIR/index.txt"
elif [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "help" ]; then
    cat "$HELP_DIR/index.txt" | less -R 2>/dev/null || cat "$HELP_DIR/index.txt"
elif [ "${1:-}" = "docs" ]; then
    if [ -n "${2:-}" ]; then
        # cat a specific shipped document (name only, no path traversal)
        _doc="${2##*/}"
        if [ -f "/usr/share/doc/aira-octave/$_doc" ]; then
            cat "/usr/share/doc/aira-octave/$_doc"
        else
            echo "no such document: $_doc (try: aira-help docs)" >&2
            exit 1
        fi
    else
        ls /usr/share/doc/aira-octave 2>/dev/null || echo "(docs not installed)"
    fi
else
    # Search for topic (leading dashes must not become grep options)
    TOPIC="$1"
    grep -i -A 5 -B 2 -- "$TOPIC" "$HELP_DIR/index.txt" | head -n 30
fi