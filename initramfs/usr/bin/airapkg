#!/bin/sh
# airapkg — lightweight AiraOS package manager (local/offline v1).
# Format: .apkg = gzipped tar with PKGINFO at root + payload files (absolute or relative).
# DB: /var/lib/airapkg/{installed/<name>/PKGINFO,files}
set -u
DB="${AIRA_PKG_DB:-/var/lib/airapkg}"
# Payload root: packages install absolute paths ("/usr/share/..."). A prefix
# lets the installer and host tests target a staging root instead of "/".
ROOT="${AIRA_PKG_ROOT:-}"
REPO="$DB/repo"
mkdir -p "$DB/installed" "$REPO"
# Transaction log: every mutating operation records intent+result so an
# interrupted install is diagnosable after the fact (Wave C6).
TXLOG="${AIRA_PKG_TXLOG:-$DB/transactions.log}"
tx() { # tx <event> <name> <detail>
  [ -n "${AIRA_PKG_NO_TXLOG:-}" ] && return 0
  mkdir -p "$(dirname "$TXLOG")" 2>/dev/null
  printf '%s tx=%s pkg=%s %s\n' "$(date +%s 2>/dev/null || echo 0)" "$1" "${2:--}" "${3:-}" \
    >> "$TXLOG" 2>/dev/null || true
}
usage() {
  cat <<'EOF'
airapkg — AiraOS package manager (local repository)
  airapkg list                        installed packages
  airapkg search <term>               search installed + repo packages
  airapkg query <name>                show metadata + files (alias: info)
  airapkg info <name>                 alias for query
  airapkg install <file.apkg>         install (refuses if already installed unless --force)
  airapkg install --force <file>      reinstall
  airapkg remove <name>               remove files recorded at install
  airapkg verify <name>               check installed files exist
  airapkg rollback <name>             restore files overwritten at install
  airapkg update-check                compare installed vs repo versions
  airapkg build <dir> <out.apkg>      build an unsigned package (needs PKGINFO)
  airapkg sign / verify-sig            disabled until cryptographic signatures exist
  Note: SHA-256 checksums detect changes but do not authenticate a publisher.
PKGINFO fields: NAME, VERSION, DESC, DEPS (space-separated, optional)
Repo: drop .apkg files in /var/lib/airapkg/repo (local-only in 0.2).
EOF
}
pkgdir() { echo "$DB/installed/$1"; }
need() { [ -n "${2:-}" ] || { echo "usage error: $1" >&2; usage >&2; exit 2; }; }

cmd="${1:-list}"
case "$cmd" in
  help|--help|-h) usage ;;
  list)
    ls "$DB/installed" 2>/dev/null || echo "(none)"
    ;;
  query|info)
    need "airapkg query <name>" "${2:-}"
    d="$(pkgdir "$2")"
    if [ -f "$d/PKGINFO" ]; then
      cat "$d/PKGINFO"
      echo "--- files ---"
      cat "$d/files" 2>/dev/null || echo "(no file list)"
    else
      # fall back to repo metadata
      found=0
      for p in "$REPO"/*.apkg; do
        [ -f "$p" ] || continue
        if tar -xzOf "$p" ./PKGINFO 2>/dev/null | grep -q "^NAME=\"$2\""; then
          echo "--- repo package: $p ---"
          tar -xzOf "$p" ./PKGINFO 2>/dev/null
          found=1
        fi
      done
      [ "$found" = "1" ] || { echo "not installed and not in repo: $2" >&2; exit 1; }
    fi
    ;;
  search)
    need "airapkg search <term>" "${2:-}"
    echo "== installed =="
    ls "$DB/installed" 2>/dev/null | grep -i "$2" || echo "(no match)"
    echo "== repo ($REPO) =="
    hit=0
    for p in "$REPO"/*.apkg; do
      [ -f "$p" ] || continue
      if tar -tzf "$p" 2>/dev/null | grep -qi "$2" || basename "$p" | grep -qi "$2"; then
        echo "$p"; hit=1
      fi
    done
    [ "$hit" = "1" ] || echo "(no match)"
    ;;
  update-check)
    echo "== installed vs repo =="
    any=0
    for d in "$DB"/installed/*/; do
      [ -f "$d/PKGINFO" ] || continue
      # parse-only (never source PKGINFO: untrusted content must not execute)
      n="$(sed -n 's/^NAME="\(.*\)"/\1/p' "$d/PKGINFO" 2>/dev/null | head -n 1)"
      v="$(sed -n 's/^VERSION="\(.*\)"/\1/p' "$d/PKGINFO" 2>/dev/null | head -n 1)"
      for p in "$REPO"/*.apkg; do
        [ -f "$p" ] || continue
        rv="$(tar -xzOf "$p" ./PKGINFO 2>/dev/null | sed -n 's/^VERSION="\(.*\)"/\1/p' | head -n 1)"
        rn="$(tar -xzOf "$p" ./PKGINFO 2>/dev/null | sed -n 's/^NAME="\(.*\)"/\1/p' | head -n 1)"
        if [ "$rn" = "$n" ] && [ -n "$rv" ] && [ "$rv" != "$v" ]; then
          echo "$n: installed $v, repo $rv ($p)"; any=1
        fi
      done
    done
    [ "$any" = "1" ] || echo "(all installed packages match repo or repo empty)"
    ;;
  verify)
    need "airapkg verify <name>" "${2:-}"
    d="$(pkgdir "$2")"
    [ -f "$d/files" ] || { echo "not installed: $2" >&2; exit 1; }
    miss=0
    while IFS= read -r f; do
      [ -e "$ROOT$f" ] || { echo "MISSING $f"; miss=1; }
    done < "$d/files"
    [ "$miss" = "0" ] && echo "$2: verify OK" || { echo "$2: verify FAIL"; exit 1; }
    ;;
  install)
    force=0
    if [ "${2:-}" = "--force" ]; then force=1; shift; fi
    need "airapkg install <file.apkg>" "${2:-}"
    f="$2"
    [ -f "$f" ] || { echo "file not found: $f" >&2; exit 1; }
    tmp="$(mktemp -d)"
    # Pre-validate raw tar members for absolute/traversal before extraction
    if tar -tzf "$f" 2>/dev/null > "$tmp/members.txt"; then
      # Duplicate members are ambiguous: extraction order decides which wins,
      # so a malicious archive can smuggle a benign-looking file past a naive
      # validator and then replace it. Reject duplicates outright.
      : > "$tmp/seen.txt"
      while IFS= read -r m; do
        # strip leading ./ if present
        case "$m" in
          ./*) m="${m#./}" ;;
          . ) continue ;;
        esac
        [ -n "$m" ] || continue
        if grep -Fxq "$m" "$tmp/seen.txt" 2>/dev/null; then
          echo "airapkg: reject duplicate archive member '$m'" >&2; rm -rf "$tmp"; exit 1
        fi
        echo "$m" >> "$tmp/seen.txt"
        case "$m" in
          /*) echo "airapkg: reject absolute path '$m'" >&2; rm -rf "$tmp"; exit 1 ;;
          ../*|*/../*|*"/.."|..) echo "airapkg: reject traversal '$m'" >&2; rm -rf "$tmp"; exit 1 ;;
        esac
        # reject any component exactly ".."
        _old_ifs="$IFS"; IFS="/"
        # shellcheck disable=SC2086
        set -- $m
        for _c in "$@"; do
          if [ "$_c" = ".." ]; then echo "airapkg: reject traversal component '$m'" >&2; rm -rf "$tmp"; exit 1; fi
        done
        IFS="$_old_ifs"
      done < "$tmp/members.txt"
      # reject symlink/hardlink members via verbose listing (first char l or h)
      if tar -tvzf "$f" 2>/dev/null | grep -Eq "^[lh]"; then
        echo "airapkg: reject symlink/hardlink member" >&2; rm -rf "$tmp"; exit 1
      fi
    else
      echo "invalid .apkg (tar list failed)" >&2; rm -rf "$tmp"; exit 1
    fi
    tar -xzf "$f" -C "$tmp" || { echo "invalid .apkg (tar extract failed)" >&2; rm -rf "$tmp"; exit 1; }
    [ -f "$tmp/PKGINFO" ] || { echo "invalid .apkg (no PKGINFO)" >&2; rm -rf "$tmp"; exit 1; }
    # reject any symlink that survived extraction (paranoid)
    if find "$tmp" -type l 2>/dev/null | grep -q .; then
      echo "airapkg: reject symlink in payload" >&2; rm -rf "$tmp"; exit 1
    fi
    # parse-only PKGINFO (never source: package content is untrusted and
    # sourcing would execute embedded shell code)
    NAME="$(sed -n 's/^NAME="\(.*\)"/\1/p' "$tmp/PKGINFO" 2>/dev/null | head -n 1)"
    VERSION="$(sed -n 's/^VERSION="\(.*\)"/\1/p' "$tmp/PKGINFO" 2>/dev/null | head -n 1)"
    # NAME/VERSION must be safe tokens (no paths, no shell metachars)
    case "$NAME" in ""|*/*|*" "*|*'`'*|*'$'*|*';'*|*'"'*|*"$(printf '\n') "*) echo "invalid PKGINFO (bad NAME)" >&2; rm -rf "$tmp"; exit 1 ;; esac
    case "$VERSION" in ""|*/*|*" "*) echo "invalid PKGINFO (bad VERSION)" >&2; rm -rf "$tmp"; exit 1 ;; esac
    [ -n "${NAME:-}" ] && [ -n "${VERSION:-}" ] || { echo "invalid PKGINFO (need NAME+VERSION)" >&2; rm -rf "$tmp"; exit 1; }
    tx install "$NAME" "begin version=$VERSION from=$(basename "$f")"
    if [ -d "$(pkgdir "$NAME")" ] && [ "$force" != "1" ]; then
      echo "$NAME already installed (use --force)" >&2; rm -rf "$tmp"; exit 1
    fi
    # dependency check (warn only in v1, do not auto-resolve)
    DEPS="$(sed -n 's/^DEPS="\(.*\)"/\1/p' "$tmp/PKGINFO" 2>/dev/null | head -n 1)"
    for dep in ${DEPS:-}; do
      [ -d "$(pkgdir "$dep")" ] || echo "WARN: dependency $dep not installed"
    done
    # --- atomic transaction: stage DB then commit only on success ---
    staged="$(mktemp -d)"
    mkdir -p "$staged"
    cp -f "$tmp/PKGINFO" "$staged/PKGINFO"
    mkdir -p "$staged/backup"
    : > "$staged/files"
    : > "$staged/backup-files"
    # Sort payload paths for deterministic install/rollback order.
    (cd "$tmp" && find . -mindepth 1 -not -name PKGINFO -not -name members.txt -not -name seen.txt -not -name list.txt | LC_ALL=C sort) > "$tmp/list.txt"
    _install_failed=0
    rollback_payload() {
      _rb_failed=0
      if [ -f "$staged/files" ]; then
        while IFS= read -r _rb_pf; do
          [ -n "$_rb_pf" ] || continue
          rm -f "$ROOT$_rb_pf" 2>/dev/null || _rb_failed=1
        done < "$staged/files"
      fi
      if [ -f "$staged/backup-files" ]; then
        while IFS= read -r _rb_pf; do
          [ -n "$_rb_pf" ] || continue
          _rb_rel="${_rb_pf#/}"
          _rb_dest="$ROOT$_rb_pf"
          _rb_backup="$staged/backup/$_rb_rel"
          if [ -f "$_rb_backup" ]; then
            mkdir -p "$(dirname "$_rb_dest")" || _rb_failed=1
            cp -p "$_rb_backup" "$_rb_dest" || _rb_failed=1
          fi
        done < "$staged/backup-files"
      fi
      return "$_rb_failed"
    }
    while IFS= read -r rel; do
      rel="${rel#./}"
      [ -n "$rel" ] || continue
      # skip our own validation artifacts if present
      case "$rel" in
        members.txt|seen.txt|list.txt) continue ;;
      esac
      src="$tmp/$rel"
      # Keep package-relative paths in the DB; apply ROOT only at deployment time.
      dest="$ROOT/$rel"
      rec="/$rel"
      if [ -d "$src" ] && [ ! -L "$src" ]; then
        mkdir -p "$dest" || { _install_failed=1; break; }
        # preserve directory mode when possible (busybox: no chmod --reference)
        _sm="$(stat -c %a "$src" 2>/dev/null || true)"
        [ -n "$_sm" ] && chmod "$_sm" "$dest" 2>/dev/null || true
      else
        mkdir -p "$(dirname "$dest")" || { _install_failed=1; break; }
        if [ -e "$dest" ]; then
          if ! mkdir -p "$staged/backup/$(dirname "$rel")" 2>/dev/null ||
             ! cp -p "$dest" "$staged/backup/$rel" 2>/dev/null; then
            echo "airapkg: could not back up existing file $rec; refusing overwrite" >&2
            _install_failed=1
            break
          fi
          echo "$rec" >> "$staged/backup-files" || { _install_failed=1; break; }
        fi
        # Record before copying so a partially written file is also removed on
        # rollback if the copy fails part-way through.
        echo "$rec" >> "$staged/files" || { _install_failed=1; break; }
        cp -p "$src" "$dest" 2>/dev/null || cp -f "$src" "$dest" || { _install_failed=1; break; }
        # busybox chmod has no --reference: cp -p already preserved the mode;
        # only repair the old blind-+x bug if mode looks wrong.
        if [ -x "$src" ]; then
          [ -x "$dest" ] || chmod 755 "$dest" 2>/dev/null || true
        else
          if [ -x "$dest" ]; then chmod 644 "$dest" 2>/dev/null || true; fi
        fi
      fi
    done < "$tmp/list.txt"
    if     [ "$_install_failed" = "1" ]; then
      echo "airapkg: install failed, rolling back partial" >&2
      tx install "${NAME:-unknown}" "failed-rolling-back"
      if rollback_payload; then
        rm -rf "$staged"
      else
        echo "CRITICAL: payload rollback incomplete; recovery files retained at $staged" >&2
      fi
      rm -rf "$tmp"
      exit 1
    fi
    # Commit the DB entry atomically. `rm -rf` followed by `mv` is NOT atomic:
    # a crash in between leaves the package unrecorded while its payload files
    # are already on disk. Instead, keep the old entry aside and rename the new
    # one into place, restoring the old entry if the rename fails.
    mkdir -p "$(dirname "$(pkgdir "$NAME")")"
    # remember previous file list so upgrade can drop stale files
    _oldfiles=""
    if [ -f "$(pkgdir "$NAME")/files" ]; then
      _oldfiles="$(mktemp)"
      cp -f "$(pkgdir "$NAME")/files" "$_oldfiles"
    fi
    _prev=""
    if [ -d "$(pkgdir "$NAME")" ]; then
      _prev="$(pkgdir "$NAME").prev.$"
      if ! mv "$(pkgdir "$NAME")" "$_prev" 2>/dev/null; then
        echo "airapkg: could not stage previous DB entry; rolling back payload" >&2
        if rollback_payload; then rm -rf "$staged"; else echo "CRITICAL: recovery files retained at $staged" >&2; fi
        rm -rf "$tmp"
        exit 1
      fi
    fi
    if mv "$staged" "$(pkgdir "$NAME")" 2>/dev/null; then
      [ -n "$_prev" ] && rm -rf "$_prev" 2>/dev/null
    else
      # The payload is already on disk: restore it before discarding backups.
      if [ -n "$_prev" ]; then mv "$_prev" "$(pkgdir "$NAME")" 2>/dev/null || echo "CRITICAL: previous package DB entry restore failed" >&2; fi
      if rollback_payload; then
        rm -rf "$staged"
      else
        echo "CRITICAL: payload rollback incomplete; recovery files retained at $staged" >&2
      fi
      rm -rf "$tmp" 2>/dev/null
      echo "airapkg: DB commit failed; payload rollback attempted" >&2
      exit 1
    fi
    # remove stale files present in old version but absent from new version
    if [ -n "$_oldfiles" ] && [ -f "$_oldfiles" ]; then
      while IFS= read -r _of; do
        [ -n "$_of" ] || continue
        if ! grep -Fxq "$_of" "$(pkgdir "$NAME")/files" 2>/dev/null; then
          rm -f "$ROOT$_of" 2>/dev/null && echo "removed stale $_of"
        fi
      done < "$_oldfiles"
      rm -f "$_oldfiles"
    fi
    rm -rf "$tmp"
    tx commit "$NAME" "version=$VERSION"
    echo "$NAME $VERSION installed"
    ;;
  rollback)
    need "airapkg rollback <name>" "${2:-}"
    d="$(pkgdir "$2")"
    [ -f "$d/PKGINFO" ] || { echo "not installed: $2" >&2; exit 1; }
    [ -f "$d/backup-files" ] || { echo "$2: nothing to roll back" >&2; exit 1; }
    tx rollback "$2" "start"
    restored=0; dropped=0
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      rel="${f#/}"
      _dep="$ROOT$f"
      if [ -f "$d/backup/$rel" ]; then
        cp -f "$d/backup/$rel" "$_dep" && restored=$((restored+1))
      else
        rm -f "$_dep" 2>/dev/null && dropped=$((dropped+1))
      fi
    done < "$d/files"
    tx rollback "$2" "restored=$restored dropped=$dropped"
    echo "$2: rollback done (restored $restored, removed $dropped new)"
    ;;
  remove)
    need "airapkg remove <name>" "${2:-}"
    d="$(pkgdir "$2")"
    [ -f "$d/PKGINFO" ] || { echo "not installed: $2" >&2; exit 1; }
    if [ -d "$d" ]; then tx remove "$2" "start"; fi
    if [ -f "$d/files" ]; then
      while IFS= read -r f; do rm -f "$ROOT$f" 2>/dev/null || true; done < "$d/files"
    fi
    rm -rf "$d"
    tx remove "$2" "done"
    echo "$2 removed"
    ;;
  build)
    need "airapkg build <dir> <out.apkg>" "${3:-}"
    src="$2"; out="$3"; shift 3
    while [ $# -gt 0 ]; do
        case "$1" in
            --sign)
                echo "airapkg: cryptographic signing is not implemented; refusing to claim a signed package" >&2
                exit 2
                ;;
            *)
                echo "airapkg: unknown build option: $1" >&2
                exit 2
                ;;
        esac
    done
    [ -f "$src/PKGINFO" ] || { echo "need $src/PKGINFO" >&2; exit 1; }
    tar -czf "$out" -C "$src" . || exit 1
    echo "built unsigned package $out"
    ;;
  sign)
    need "airapkg sign <file.apkg> <private-key>" "${3:-}"
    f="$2"; key="$3"
    [ -f "$f" ] || { echo "file not found: $f" >&2; exit 1; }
    [ -f "$key" ] || { echo "key not found: $key" >&2; exit 1; }
    echo "airapkg: cryptographic package signing is not implemented; no signature was written" >&2
    exit 2
    ;;
  verify-sig)
    need "airapkg verify-sig <file.apkg> <public-key>" "${3:-}"
    f="$2"; key="$3"
    [ -f "$f" ] || { echo "file not found: $f" >&2; exit 1; }
    [ -f "$key" ] || { echo "key not found: $key" >&2; exit 1; }
    echo "airapkg: cryptographic signature verification is not implemented; refusing to treat SHA-256 as a signature" >&2
    exit 2
    ;;
  *) echo "unknown: $cmd" >&2; usage >&2; exit 2 ;;
esac
