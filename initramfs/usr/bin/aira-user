#!/bin/sh
# AiraOS User Management - adduser, deluser, passwd, groups, login
# Real user account management with password support.

set -u

usage() {
    cat <<'EOF'
aira-user — AiraOS user management
  aira-user adduser <name> [--uid N] [--gid N] [--home DIR] [--shell SHELL] [--gecos "Name"]
  aira-user deluser <name> [--remove-home]
  aira-user passwd <name> [--stdin]
  aira-user addgroup <name> [--gid N]
  aira-user delgroup <name>
  aira-user usermod <name> [--uid N] [--gid N] [--home DIR] [--shell SHELL] [--gecos "Name"] [--lock|--unlock]
  aira-user groups <name>
  aira-user list
  aira-user login <name>    # Start login shell as user (requires root)
EOF
}

# --- validation (credential-file safety) -------------------------------
# Usernames/groups become part of a colon-delimited system file AND are used
# as sed/grep patterns. Unvalidated input could therefore either inject a new
# field (corrupting passwd/shadow) or turn a pattern into a wildcard that
# matches — and rewrites the wrong accounts. Reject anything unexpected
# before it reaches a file.
# Policy: lowercase alnum plus '_' '-' '.', must start alnum, max 32 chars.
valid_name() {
    case "${1:-}" in
        "" ) return 1 ;;
        [a-z0-9]* ) : ;;
        * ) return 1 ;;
    esac
    case "$1" in *[!a-z0-9._-]*) return 1 ;; esac
    [ "${#1}" -le 32 ] || return 1
    return 0
}

valid_uid() {
    case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
    [ "$1" -ge 0 ] 2>/dev/null || return 1
    [ "$1" -le 65535 ] 2>/dev/null || return 1
    return 0
}

# Paths: absolute, no traversal, and built only from a whitelist of safe
# characters. A blacklist cannot be exhaustive (metacharacters are endless),
# so allowlist instead.
valid_path() {
    case "${1:-}" in
        "" ) return 1 ;;
        /*) : ;;
        * ) return 1 ;;
    esac
    # No whitespace, no control characters, no traversal segments.
    case "$1" in
        *" "*|*"	"*|*"$"*|*"'"*|*"\\"*|*".."*|*"/../"*|*"//"*) return 1 ;;
    esac
    # Allowlist: letters, digits and a small set of harmless punctuation.
    case "$1" in
        *[!A-Za-z0-9/._+@,=%:^\[\]-]*) return 1 ;;
    esac
    return 0
}

# GECOS is a comment field: forbid the delimiter and control characters.
valid_gecos() {
    case "${1:-}" in
        "" ) return 0 ;;
        *:*|*"
"*|*","*) return 1 ;;
    esac
    return 0
}

require_name() {
    valid_name "$1" || {
        echo "Invalid name '$1': use lowercase letters, digits, '_', '-' or '.' (max 32, must start alphanumeric)" >&2
        exit 1
    }
}

# Exact-match lookup that never interprets the name as a pattern.
passwd_field() { # passwd_field <file> <name> <field>
    awk -F: -v n="$2" -v f="$3" '$1==n { print $f; exit }' "$1" 2>/dev/null
}
name_exists() { # name_exists <file> <name>
    awk -F: -v n="$2" '$1==n { found=1 } END { exit !found }' "$1" 2>/dev/null
}

# Credential file locations. AIRA_USER_ETC exists so the security tests can
# exercise aira-user against a sandbox copy instead of the live /etc.
# /etc/shadow in the image has no trailing newline. Appending straight to it
# would glue the new row onto the previous one and corrupt the database, so
# every file we append to is first checked for a final newline.
ensure_trailing_nl() { # ensure_trailing_nl <file>
    [ -f "$1" ] || return 0
    [ -s "$1" ] || return 0
    _last="$(tail -c 1 "$1" 2>/dev/null | od -An -tu1 2>/dev/null | tr -d ' \n')"
    [ "$_last" = "10" ] || printf '\n' >> "$1"
}

ETC="${AIRA_USER_ETC:-/etc}"
PASSWD="$ETC/passwd"
SHADOW="$ETC/shadow"
GROUP="$ETC/group"
TMPDIR="${TMPDIR:-/tmp}"
SHADOW_MODE="${AIRA_USER_SHADOW_MODE:-640}"
# Directories under which a home directory may be recursively removed.
HOME_ROOTS="${AIRA_USER_HOME_ROOTS:-/home /root /var /srv}"

# Read the account database and find the next free UID/GID
get_next_uid() {
    awk -F: '$3 >= 1000 && $3 < 65534 {print $3}' "$PASSWD" | sort -n | tail -1 | awk '{print $1+1}'
}
get_next_gid() {
    awk -F: '$3 >= 1000 && $3 < 65534 {print $3}' "$GROUP" | sort -n | tail -1 | awk '{print $1+1}'
}

# Write helper: filter "FILE" by an awk program, then replace it in place.
# TMPDIR must be writable; if mktemp fails we abort rather than truncate.
_tmpfile() { # _tmpfile <basename>
    mktemp "$TMPDIR/aira.$1.XXXXXX" 2>/dev/null || {
        echo "Cannot create temporary file (TMPDIR=$TMPDIR)" >&2
        exit 1
    }
}
_commit() { # _commit <tmp> <target> [mode]
    [ -s "$1" ] || { rm -f "$1"; echo "Refusing to write empty $2" >&2; exit 1; }
    cat "$1" > "$2" 2>/dev/null || { rm -f "$1"; echo "Failed to write $2" >&2; exit 1; }
    # chmod the TARGET: `cat >` preserves the destination's existing mode, so
    # chmoding the tmp file would have no effect on an existing 0644 shadow.
    [ -n "${3:-}" ] && chmod "$3" "$2" 2>/dev/null
    rm -f "$1"
    return 0
}

cmd="${1:-help}"
case "$cmd" in
    help|--help|-h) usage ;;

    adduser)
        shift
        NAME=""
        UID=""
        GID=""
        HOME=""
        SHELL="/bin/sh"
        GECOS=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --uid) UID="$2"; shift 2 ;;
                --gid) GID="$2"; shift 2 ;;
                --home) HOME="$2"; shift 2 ;;
                --shell) SHELL="$2"; shift 2 ;;
                --gecos) GECOS="$2"; shift 2 ;;
                *) [ -z "$NAME" ] && NAME="$1" || { echo "Unexpected arg: $1"; usage; exit 1; }; shift ;;
            esac
        done
        [ -n "$NAME" ] || { echo "Usage: aira-user adduser <name> [options]"; exit 1; }
        require_name "$NAME"
        # An empty option means "not supplied"; a non-empty one must validate.
        [ -z "$UID" ]  || valid_uid  "$UID"  || { echo "Invalid --uid '$UID'" >&2; exit 1; }
        [ -z "$GID" ]  || valid_uid  "$GID"  || { echo "Invalid --gid '$GID'" >&2; exit 1; }
        [ -z "$HOME" ] || valid_path "$HOME" || { echo "Invalid --home '$HOME'" >&2; exit 1; }
        [ -z "$SHELL" ] || valid_path "$SHELL" || { echo "Invalid --shell '$SHELL'" >&2; exit 1; }
        valid_gecos "$GECOS" || { echo "Invalid --gecos (no ':' or newline)" >&2; exit 1; }
        [ -r "$PASSWD" ] || { echo "$PASSWD missing or unreadable" >&2; exit 1; }

        # Check if user exists
        if name_exists "$PASSWD" "$NAME"; then
            echo "User $NAME already exists"
            exit 1
        fi

        [ -n "$UID" ] || UID=$(get_next_uid)
        [ -n "$UID" ] || UID=1000
        [ -n "$GID" ] || GID=$UID
        [ -n "$HOME" ] || HOME="/home/$NAME"
        valid_uid "$UID" || { echo "Invalid uid '$UID'" >&2; exit 1; }
        valid_uid "$GID" || { echo "Invalid gid '$GID'" >&2; exit 1; }

        # Refuse a UID that is already owned by a different account.
        _uid_owner="$(awk -F: -v u="$UID" '$3==u { print $1; exit }' "$PASSWD" 2>/dev/null)"
        [ -z "$_uid_owner" ] || { echo "UID $UID already used by $_uid_owner" >&2; exit 1; }

        # Build the new database content first, then commit both files. If any
        # step fails the database is left exactly as it was.
        _ptmp="$(_tmpfile passwd)"
        _stmp="$(_tmpfile shadow)"
        _gtmp="$(_tmpfile group)"
        cat "$PASSWD" > "$_ptmp"
        cat "$SHADOW" > "$_stmp" 2>/dev/null || true
        cat "$GROUP" > "$_gtmp"
        ensure_trailing_nl "$_ptmp"
        ensure_trailing_nl "$_stmp"
        ensure_trailing_nl "$_gtmp"

        # Create the dedicated group if that GID is unused.
        if ! awk -F: -v g="$GID" '$3==g { found=1 } END { exit !found }' "$_gtmp" 2>/dev/null; then
            printf '%s:x:%s:\n' "$NAME" "$GID" >> "$_gtmp"
        fi

        # Validated fields only; ':' cannot appear in any of them.
        printf '%s:x:%s:%s:%s:%s:%s\n' "$NAME" "$UID" "$GID" "${GECOS:-$NAME}" "$HOME" "$SHELL" >> "$_ptmp"
        printf '%s:*:19000:0:99999:7:::\n' "$NAME" >> "$_stmp"

        _commit "$_gtmp" "$GROUP"
        _commit "$_stmp" "$SHADOW" "$SHADOW_MODE"
        _commit "$_ptmp" "$PASSWD"

        # Create home directory
        mkdir -p "$HOME" 2>/dev/null || echo "Warning: could not create $HOME" >&2
        chown "$UID:$GID" "$HOME" 2>/dev/null || true
        chmod 755 "$HOME" 2>/dev/null || true

        # Copy skeleton files
        [ -d /etc/skel ] && cp -r /etc/skel/. "$HOME/" 2>/dev/null
        chown -R "$UID:$GID" "$HOME" 2>/dev/null || true

        echo "User $NAME created (uid=$UID, gid=$GID, home=$HOME)"
        ;;

    deluser)
        shift
        NAME=""
        REMOVE_HOME=0
        while [ $# -gt 0 ]; do
            case "$1" in
                --remove-home) REMOVE_HOME=1; shift ;;
                *) [ -z "$NAME" ] && NAME="$1" || { echo "Unexpected arg: $1"; exit 1; }; shift ;;
            esac
        done
        [ -n "$NAME" ] || { echo "Usage: aira-user deluser <name> [--remove-home]"; exit 1; }
        require_name "$NAME"

        name_exists "$PASSWD" "$NAME" || { echo "User $NAME does not exist"; exit 1; }

        if [ "$NAME" = "root" ]; then
            echo "Cannot delete root user"
            exit 1
        fi

        # Capture the home path BEFORE the passwd entry is removed, and only
        # ever delete a path under a known home root.
        _uhome="$(awk -F: -v n="$NAME" '$1==n { print $6; exit }' "$PASSWD" 2>/dev/null)"

        # Prepare all three files, commit only after every filter succeeded.
        _ptmp="$(_tmpfile passwd)"
        _stmp="$(_tmpfile shadow)"
        _gtmp="$(_tmpfile group)"
        awk -F: -v n="$NAME" '$1!=n' "$PASSWD" > "$_ptmp" 2>/dev/null || { rm -f "$_ptmp" "$_stmp" "$_gtmp"; echo "Failed to update $PASSWD" >&2; exit 1; }
        awk -F: -v n="$NAME" '$1!=n' "$SHADOW" > "$_stmp" 2>/dev/null || true
        # Drop the member from every group list (exact match, not a pattern).
        awk -F: -v n="$NAME" 'BEGIN{OFS=":"}
          { $4=sep($4, n); print }
          function sep(list, item,  a,i,out){ m=split(list,a,","); out="";
            for(i=1;i<=m;i++){ if(a[i]==item) continue; out=(out==""? a[i] : out "," a[i]) } return out }' \
          "$GROUP" > "$_gtmp" 2>/dev/null || { rm -f "$_ptmp" "$_stmp" "$_gtmp"; echo "Failed to update $GROUP" >&2; exit 1; }
        _commit "$_gtmp" "$GROUP"
        _commit "$_stmp" "$SHADOW" "$SHADOW_MODE" || true
        _commit "$_ptmp" "$PASSWD"

        if [ "$REMOVE_HOME" = "1" ]; then
            if [ -n "$_uhome" ] && valid_path "$_uhome" && [ "$_uhome" != "/" ]; then
                # Only ever recurse under an approved home root, so a crafted
                # or corrupt home field can never delete unrelated data.
                _allowed=0
                for _root in $HOME_ROOTS; do
                    case "$_uhome" in
                        "$_root"|"$_root"/*) _allowed=1 ;;
                    esac
                done
                if [ "$_allowed" = "1" ]; then
                    rm -rf "$_uhome"
                else
                    echo "Refusing to remove home outside approved roots: $_uhome" >&2
                fi
            fi
        fi

        echo "User $NAME deleted"
        ;;

    passwd)
        shift
        NAME=""
        STDIN=0
        while [ $# -gt 0 ]; do
            case "$1" in
                --stdin) STDIN=1; shift ;;
                *) [ -z "$NAME" ] && NAME="$1" || { echo "Unexpected arg: $1"; exit 1; }; shift ;;
            esac
        done
        [ -n "$NAME" ] || { echo "Usage: aira-user passwd <name> [--stdin]"; exit 1; }
        require_name "$NAME"

        name_exists "$PASSWD" "$NAME" || { echo "User $NAME does not exist"; exit 1; }
        [ "$NAME" = "root" ] && { echo "Refusing to set the root password via this tool (use recovery)"; exit 1; }

        if [ "$STDIN" = "1" ]; then
            read -r PASS
        else
            echo -n "New password: "
            stty -echo
            read -r PASS1
            echo
            echo -n "Retype password: "
            read -r PASS2
            echo
            stty echo
            [ "$PASS1" = "$PASS2" ] || { echo "Passwords do not match"; exit 1; }
            PASS="$PASS1"
        fi
        
        [ -n "$PASS" ] || { echo "Empty password refused" >&2; exit 1; }
        [ "${#PASS}" -ge 8 ] || { echo "Password too short (minimum 8 characters)" >&2; exit 1; }
        # Salted + iterated digest. A bare unsalted digest is rainbow-table
        # crackable and makes identical passwords identical on disk.
        SALT="$(head -c 12 /dev/urandom 2>/dev/null | sha256sum 2>/dev/null | cut -c1-16)"
        [ -n "$SALT" ] || SALT="$(awk -v s="$$-$(date +%s 2>/dev/null || echo 0)" 'BEGIN{printf "%016x", s*2654435761%4294967296}')"
        HASH="$(printf '%s' "$PASS" | sha256sum 2>/dev/null | cut -d' ' -f1)"
        if [ -z "$HASH" ]; then
            echo "Cannot hash password (sha256sum unavailable) — refusing to store plaintext" >&2
            exit 1
        fi
        _i=0
        while [ "$_i" -lt "${AIRA_USER_HASH_ROUNDS:-1000}" ]; do
            HASH="$(printf '%s%s%s' "$SALT" "$HASH" "$_i" | sha256sum 2>/dev/null | cut -d' ' -f1)"
            [ -n "$HASH" ] || { echo "Hashing failed" >&2; exit 1; }
            _i=$((_i+1))
        done
        # $aira1$<rounds>$<salt>$<hash> — '$' is legal inside a shadow field.
        _newhash="\$aira1\$${AIRA_USER_HASH_ROUNDS:-1000}\$$SALT\$$HASH"
        _stmp="$(_tmpfile shadow)"
        awk -F: -v n="$NAME" -v h="$_newhash" 'BEGIN{OFS=":"} $1==n{$2=h} {print}' "$SHADOW" > "$_stmp" 2>/dev/null \
            || { rm -f "$_stmp"; echo "Failed to update $SHADOW" >&2; exit 1; }
        _commit "$_stmp" "$SHADOW" "$SHADOW_MODE"
        unset PASS PASS1 PASS2
        echo "Password updated for $NAME"
        ;;

    addgroup)
        shift
        NAME=""
        GID=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --gid) GID="$2"; shift 2 ;;
                *) [ -z "$NAME" ] && NAME="$1" || { echo "Unexpected arg: $1"; exit 1; }; shift ;;
            esac
        done
        [ -n "$NAME" ] || { echo "Usage: aira-user addgroup <name> [--gid N]"; exit 1; }
        require_name "$NAME"
        [ -z "$GID" ] || valid_uid "$GID" || { echo "Invalid --gid '$GID'" >&2; exit 1; }

        if name_exists "$GROUP" "$NAME"; then
            echo "Group $NAME already exists"
            exit 1
        fi

        [ -n "$GID" ] || GID=$(get_next_gid)
        [ -n "$GID" ] || GID=1000
        valid_uid "$GID" || { echo "Invalid gid '$GID'" >&2; exit 1; }
        _g_owner="$(awk -F: -v g="$GID" '$3==g { print $1; exit }' "$GROUP" 2>/dev/null)"
        [ -z "$_g_owner" ] || { echo "GID $GID already used by $_g_owner" >&2; exit 1; }

        _gtmp="$(_tmpfile group)"
        cat "$GROUP" > "$_gtmp"
        ensure_trailing_nl "$_gtmp"
        printf '%s:x:%s:\n' "$NAME" "$GID" >> "$_gtmp"
        _commit "$_gtmp" "$GROUP"
        echo "Group $NAME created (gid=$GID)"
        ;;

    delgroup)
        shift
        NAME="${1:-}"
        [ -n "$NAME" ] || { echo "Usage: aira-user delgroup <name>"; exit 1; }
        require_name "$NAME"

        name_exists "$GROUP" "$NAME" || { echo "Group $NAME does not exist"; exit 1; }

        # Check if group is primary for any user (exact field comparison)
        GID="$(awk -F: -v n="$NAME" '$1==n { print $3; exit }' "$GROUP" 2>/dev/null)"
        if awk -F: -v g="$GID" '$4==g { found=1 } END { exit !found }' "$PASSWD" 2>/dev/null; then
            echo "Group $NAME is primary group for existing users"
            exit 1
        fi

        # Drop the group row and remove the member from other rows (exact match)
        _gtmp="$(_tmpfile group)"
        awk -F: -v n="$NAME" 'BEGIN{OFS=":"}
          $1==n { next }
          { $4=sep($4, n); print }
          function sep(list, item,  a,i,out){ m=split(list,a,","); out="";
            for(i=1;i<=m;i++){ if(a[i]==item) continue; out=(out==""? a[i] : out "," a[i]) } return out }' \
          "$GROUP" > "$_gtmp" 2>/dev/null || { rm -f "$_gtmp"; echo "Failed to update $GROUP" >&2; exit 1; }
        _commit "$_gtmp" "$GROUP"
        echo "Group $NAME deleted"
        ;;

    usermod)
        shift
        NAME=""
        UID=""
        GID=""
        HOME=""
        SHELL=""
        GECOS=""
        LOCK=0
        UNLOCK=0
        while [ $# -gt 0 ]; do
            case "$1" in
                --uid) UID="$2"; shift 2 ;;
                --gid) GID="$2"; shift 2 ;;
                --home) HOME="$2"; shift 2 ;;
                --shell) SHELL="$2"; shift 2 ;;
                --gecos) GECOS="$2"; shift 2 ;;
                --lock) LOCK=1; shift ;;
                --unlock) UNLOCK=1; shift ;;
                *) [ -z "$NAME" ] && NAME="$1" || { echo "Unexpected arg: $1"; exit 1; }; shift ;;
            esac
        done
        [ -n "$NAME" ] || { echo "Usage: aira-user usermod <name> [options]"; exit 1; }
        require_name "$NAME"
        [ -z "$UID" ]  || valid_uid  "$UID"  || { echo "Invalid --uid '$UID'" >&2; exit 1; }
        [ -z "$GID" ]  || valid_uid  "$GID"  || { echo "Invalid --gid '$GID'" >&2; exit 1; }
        [ -z "$HOME" ] || valid_path "$HOME" || { echo "Invalid --home '$HOME'" >&2; exit 1; }
        [ -z "$SHELL" ] || valid_path "$SHELL" || { echo "Invalid --shell '$SHELL'" >&2; exit 1; }
        valid_gecos "$GECOS" || { echo "Invalid --gecos (no ':' or newline)" >&2; exit 1; }
        [ "$LOCK" = "1" ] && [ "$UNLOCK" = "1" ] && { echo "Cannot combine --lock and --unlock" >&2; exit 1; }

        name_exists "$PASSWD" "$NAME" || { echo "User $NAME does not exist"; exit 1; }

        # Build new passwd line (exact match, never a pattern)
        OLD_LINE="$(awk -F: -v n="$NAME" '$1==n { print; exit }' "$PASSWD" 2>/dev/null)"
        [ -n "$OLD_LINE" ] || { echo "Cannot read $NAME from $PASSWD" >&2; exit 1; }
        OUID=$(echo "$OLD_LINE" | cut -d: -f3)
        OGID=$(echo "$OLD_LINE" | cut -d: -f4)
        OGECOS=$(echo "$OLD_LINE" | cut -d: -f5)
        OHOME=$(echo "$OLD_LINE" | cut -d: -f6)
        OSHELL=$(echo "$OLD_LINE" | cut -d: -f7)
        # Existing fields were validated on write, but re-check before
        # re-emitting them: never copy an unexpected byte into the new file.
        valid_uid "$OUID" && valid_uid "$OGID" || { echo "Corrupt entry for $NAME" >&2; exit 1; }
        valid_path "$OHOME" && valid_path "$OSHELL" || { echo "Corrupt entry for $NAME" >&2; exit 1; }

        NEW_UID="${UID:-$OUID}"
        NEW_GID="${GID:-$OGID}"
        NEW_HOME="${HOME:-$OHOME}"
        NEW_SHELL="${SHELL:-$OSHELL}"
        NEW_GECOS="${GECOS:-$OGECOS}"

        # Reject a UID that another account already owns (before touching disk).
        if [ -n "$UID" ]; then
            _o="$(awk -F: -v u="$UID" -v n="$NAME" '$3==u && $1!=n { print $1; exit }' "$PASSWD" 2>/dev/null)"
            [ -z "$_o" ] || { echo "UID $UID already used by $_o" >&2; exit 1; }
        fi

        # Move the home directory AFTER the UID check and only between valid,
        # absolute paths (a rejected request must not disturb existing data).
        if [ "$NEW_HOME" != "$OHOME" ] && [ -d "$OHOME" ] && valid_path "$NEW_HOME"; then
            if mv "$OHOME" "$NEW_HOME" 2>/dev/null; then
                chown -R "$NEW_UID:$NEW_GID" "$NEW_HOME" 2>/dev/null || true
            else
                echo "Warning: could not move $OHOME -> $NEW_HOME" >&2
            fi
        fi

        # Update passwd atomically (exact field match)
        _ptmp="$(_tmpfile passwd)"
        awk -F: -v n="$NAME" -v u="$NEW_UID" -v g="$NEW_GID" -v ge="$NEW_GECOS" -v h="$NEW_HOME" -v sh="$NEW_SHELL" \
            'BEGIN{OFS=":"} $1==n{$2="x";$3=u;$4=g;$5=ge;$6=h;$7=sh} {print}' "$PASSWD" > "$_ptmp" 2>/dev/null \
            || { rm -f "$_ptmp"; echo "Failed to update $PASSWD" >&2; exit 1; }
        _commit "$_ptmp" "$PASSWD"

        if [ "$LOCK" = "1" ]; then
            _stmp="$(_tmpfile shadow)"
            awk -F: -v n="$NAME" 'BEGIN{OFS=":"} $1==n{$2="!"} {print}' "$SHADOW" > "$_stmp" 2>/dev/null || true
            _commit "$_stmp" "$SHADOW" "$SHADOW_MODE" || true
            echo "User $NAME locked"
        fi
        if [ "$UNLOCK" = "1" ]; then
            _stmp="$(_tmpfile shadow)"
            awk -F: -v n="$NAME" 'BEGIN{OFS=":"} $1==n{$2="*"} {print}' "$SHADOW" > "$_stmp" 2>/dev/null || true
            _commit "$_stmp" "$SHADOW" "$SHADOW_MODE" || true
            echo "User $NAME unlocked"
        fi
        echo "User $NAME modified"
        ;;

    groups)
        shift
        NAME="${1:-$(whoami)}"
        if ! name_exists "$PASSWD" "$NAME"; then
            echo "User $NAME does not exist"
            exit 1
        fi
        GID="$(awk -F: -v n="$NAME" '$1==n { print $4; exit }' "$PASSWD" 2>/dev/null)"
        PRIMARY="$(awk -F: -v g="$GID" '$3==g { print $1; exit }' "$GROUP" 2>/dev/null)"
        # Groups the user belongs to by name in the member list (exact match).
        EXTRA="$(awk -F: -v n="$NAME" '{ m=split($4,a,","); for(i=1;i<=m;i++) if(a[i]==n){ print $1; break } }' "$GROUP" 2>/dev/null | tr '\n' ',')"
        echo "$PRIMARY${EXTRA:+,}${EXTRA%,}"
        ;;

    list)
        echo "Users:"
        awk -F: '{printf "  %-15s uid=%-5s gid=%-5s %s\n", $1, $3, $4, $5}' "$PASSWD"
        echo
        echo "Groups:"
        awk -F: '{printf "  %-15s gid=%-5s\n", $1, $3}' "$GROUP"
        ;;

    login)
        shift
        NAME="${1:-}"
        [ -n "$NAME" ] || { echo "Usage: aira-user login <name>"; exit 1; }
        require_name "$NAME"

        if ! name_exists "$PASSWD" "$NAME"; then
            echo "User $NAME does not exist"
            exit 1
        fi

        if [ "$(id -u)" != "0" ]; then
            echo "Login requires root privileges"
            exit 1
        fi
        # Refuse login for a locked account ("!") or one with no usable
        # password ("*"/empty). These mean different things, so say so.
        _pw="$(awk -F: -v n="$NAME" '$1==n { print $2; exit }' "$SHADOW" 2>/dev/null)"
        case "$_pw" in
            '!'*) echo "Account $NAME is locked; unlock it with 'aira-user usermod $NAME --unlock'" >&2; exit 1 ;;
            ''|'*'*) echo "Account $NAME has no password set; run 'aira-user passwd $NAME' first" >&2; exit 1 ;;
        esac

        UID=$(awk -F: -v n="$NAME" '$1==n { print $3; exit }' "$PASSWD" 2>/dev/null)
        GID=$(awk -F: -v n="$NAME" '$1==n { print $4; exit }' "$PASSWD" 2>/dev/null)
        HOME=$(awk -F: -v n="$NAME" '$1==n { print $6; exit }' "$PASSWD" 2>/dev/null)
        SHELL=$(awk -F: -v n="$NAME" '$1==n { print $7; exit }' "$PASSWD" 2>/dev/null)
        [ -n "$UID" ] && [ -n "$GID" ] && [ -n "$SHELL" ] || { echo "Corrupt entry for $NAME" >&2; exit 1; }
        valid_path "$HOME" && valid_path "$SHELL" || { echo "Corrupt entry for $NAME" >&2; exit 1; }
        [ -x "$SHELL" ] || { echo "Shell $SHELL is not executable" >&2; exit 1; }
        [ -d "$HOME" ] || { echo "Home directory $HOME does not exist" >&2; exit 1; }
        
        export HOME="$HOME"
        export USER="$NAME"
        export LOGNAME="$NAME"
        export SHELL="$SHELL"

        # Informational only; su applies the real uid/gid/groups.
        GROUPS=$(aira-user groups "$NAME" 2>/dev/null | tr ',' ' ')
        export GROUPS
        
        cd "$HOME" 2>/dev/null || { echo "Cannot enter $HOME" >&2; exit 1; }
        # Drop privileges via su so the target uid/gid/groups actually apply.
        exec su -s "$SHELL" "$NAME"
        ;;

    *) echo "Unknown command: $cmd"; usage; exit 1 ;;
esac