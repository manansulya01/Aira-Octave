#!/bin/sh
# AiraOS Audio Service - ALSA-based audio management.
# Usage: aira-audio {start|stop|status|volume|mute|unmute|list|test}

set -u

CMD="${1:-status}"
SND_CARD="${AIRA_AUDIO_CARD:-0}"

usage() {
    cat <<'EOF'
aira-audio — AiraOS audio management
  aira-audio start               Start audio service
  aira-audio stop                Stop audio service
  aira-audio status              Show audio status
  aira-audio volume [0-100]      Get/set master volume
  aira-audio mute                Mute master
  aira-audio unmute              Unmute master
  aira-audio list                List audio devices
  aira-audio test                Play test sound
EOF
}

start_audio() {
    echo "[audio] Starting audio service..."
    # Load ALSA modules
    modprobe -q snd_pcm 2>/dev/null
    modprobe -q snd_timer 2>/dev/null
    modprobe -q snd_virtio 2>/dev/null
    modprobe -q snd_intel8x0 2>/dev/null
    modprobe -q snd_hda_intel 2>/dev/null
    
    # Initialize ALSA
    alsactl init 2>/dev/null || true
    
    # Set default volume
    amixer -c "$SND_CARD" sset Master 70% unmute 2>/dev/null || true
    
    echo "[audio] Audio service started"
}

stop_audio() {
    echo "[audio] Stopping audio service..."
    # Mute and save state
    amixer -c "$SND_CARD" sset Master mute 2>/dev/null || true
    alsactl store 2>/dev/null || true
    echo "[audio] Audio service stopped"
}

status_audio() {
    echo "=== Audio Status ==="
    echo "Sound card: $SND_CARD"
    echo
    echo "--- Playback devices ---"
    aplay -l 2>/dev/null || echo "No playback devices"
    echo
    echo "--- Capture devices ---"
    arecord -l 2>/dev/null || echo "No capture devices"
    echo
    echo "--- Mixer controls ---"
    amixer -c "$SND_CARD" scontents 2>/dev/null | head -n 30 || echo "No mixer"
    echo
    echo "--- ALSA state ---"
    alsactl --file=- store 2>/dev/null | head -n 20
}

volume_audio() {
    VOL="${2:-}"
    if [ -z "$VOL" ]; then
        # Get current volume
        amixer -c "$SND_CARD" get Master 2>/dev/null | grep -o '[0-9]*%' | head -1
    else
        # Set volume
        case "$VOL" in
            *[!0-9]*|"") echo "Invalid volume"; exit 1 ;;
        esac
        [ "$VOL" -ge 0 ] && [ "$VOL" -le 100 ] || { echo "Volume must be 0-100"; exit 1; }
        amixer -c "$SND_CARD" sset Master "${VOL}%" 2>/dev/null
        echo "Volume set to ${VOL}%"
    fi
}

mute_audio() {
    amixer -c "$SND_CARD" sset Master mute 2>/dev/null
    echo "Muted"
}

unmute_audio() {
    amixer -c "$SND_CARD" sset Master unmute 2>/dev/null
    echo "Unmuted"
}

list_audio() {
    echo "=== Audio Devices ==="
    echo "Playback:"
    aplay -L 2>/dev/null | grep -v '^$' | sed 's/^/  /'
    echo
    echo "Capture:"
    arecord -L 2>/dev/null | grep -v '^$' | sed 's/^/  /'
}

test_audio() {
    echo "[audio] Playing test tone..."
    # Generate a simple sine wave test
    speaker-test -t sine -f 440 -c 2 -l 1 2>/dev/null || \
    (dd if=/dev/zero bs=1k count=48 2>/dev/null | aplay -f S16_LE -c 2 -r 48000 2>/dev/null) || \
    echo "Test completed (no audio output device)"
}

case "$CMD" in
    start) start_audio ;;
    stop) stop_audio ;;
    status) status_audio ;;
    volume) volume_audio "$@" ;;
    mute) mute_audio ;;
    unmute) unmute_audio ;;
    list) list_audio ;;
    test) test_audio ;;
    help|--help|-h) usage ;;
    *) echo "Unknown command: $CMD"; usage; exit 1 ;;
esac