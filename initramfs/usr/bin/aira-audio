#!/bin/sh
# AiraOS Audio Service — ALSA userspace controls with explicit failure reporting.
# Usage: aira-audio {start|stop|status|volume|mute|unmute|list|test}

set -u

CMD="${1:-status}"
SND_CARD="${AIRA_AUDIO_CARD:-0}"
MIXER_CONTROL="${AIRA_AUDIO_CONTROL:-}"

# ALSA tools and shared libraries are staged on the persistent rootfs.
case ":$PATH:" in
    *:/persist/usr/bin:*) ;;
    *) PATH="/persist/usr/bin:$PATH" ;;
esac
case ":$PATH:" in
    *:/persist/usr/sbin:*) ;;
    *) PATH="/persist/usr/sbin:$PATH" ;;
esac
case ":$PATH:" in
    *:/persist/bin:*) ;;
    *) PATH="/persist/bin:$PATH" ;;
esac
case ":$PATH:" in
    *:/persist/sbin:*) ;;
    *) PATH="/persist/sbin:$PATH" ;;
esac
export PATH
LD_LIBRARY_PATH="/persist/usr/lib/x86_64-linux-gnu:/persist/lib/x86_64-linux-gnu:/persist/usr/lib:/persist/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH

usage() {
    cat <<'EOF'
aira-audio — AiraOS audio management
  aira-audio start               Initialize ALSA and set the default volume
  aira-audio stop                Mute audio and save ALSA state when possible
  aira-audio status              Show audio status
  aira-audio volume [0-100]      Get/set master volume
  aira-audio mute                Mute master
  aira-audio unmute              Unmute master
  aira-audio list                List audio devices
  aira-audio test                Play test sound
EOF
}

require_tool() {
    command -v "$1" >/dev/null 2>&1 || {
        echo "aira-audio: required ALSA tool '$1' is not installed" >&2
        return 1
    }
}

has_playback_pcm() {
    # ALSA proc inventory can report playback PCMs when aplay -l cannot enumerate them.
    # This is detection only; the actual tone test remains a separate hard gate.
    _pcm_inventory="${AIRA_ASOUND_PCM_PATH:-/proc/asound/pcm}"
    [ -r "$_pcm_inventory" ] && grep -Eiq 'playback[[:space:]]+[1-9]' "$_pcm_inventory"
}

select_mixer_control() {
    if [ -n "$MIXER_CONTROL" ]; then
        amixer -c "$SND_CARD" sget "$MIXER_CONTROL" >/dev/null 2>&1 && return 0
        echo "aira-audio: mixer control '$MIXER_CONTROL' is unavailable on card '$SND_CARD'" >&2
        return 1
    fi
    for _control in Master PCM Speaker Headphone; do
        if amixer -c "$SND_CARD" sget "$_control" >/dev/null 2>&1; then
            MIXER_CONTROL="$_control"
            return 0
        fi
    done
    echo "aira-audio: no supported mixer control found on card '$SND_CARD'" >&2
    return 1
}

start_audio() {
    echo "[audio] Starting audio service..."
    require_tool amixer || return 1

    # Optional module probes: the device may be built in or use another driver.
    modprobe -q snd_pcm 2>/dev/null || true
    modprobe -q snd_timer 2>/dev/null || true
    modprobe -q snd_virtio 2>/dev/null || true
    modprobe -q snd_intel8x0 2>/dev/null || true
    modprobe -q snd_hda_intel 2>/dev/null || true
    if ! select_mixer_control; then
        # Some virtual and embedded HDA devices expose playback but no ALSA
        # mixer controls. Do not claim volume/mute support; allow startup only
        # when ALSA independently reports a real playback device. The test
        # command still has to submit audio successfully before guest CI passes.
        if { command -v aplay >/dev/null 2>&1 && aplay -l 2>/dev/null | grep -q '^card [0-9]'; } || has_playback_pcm; then
            MIXER_CONTROL=""
            echo "[audio] WARNING: playback PCM detected but no mixer controls; volume/mute unavailable" >&2
            echo "[audio] Audio playback service started (degraded: no mixer controls)"
            return 0
        fi
        echo "aira-audio: no usable mixer controls or playback device on card '$SND_CARD'" >&2
        if command -v aplay >/dev/null 2>&1; then
            echo "[audio] diagnostic: aplay -l output follows" >&2
            aplay -l 2>&1 | head -n 20 >&2 || true
        fi
        _pcm_inventory="${AIRA_ASOUND_PCM_PATH:-/proc/asound/pcm}"
        if [ -r "$_pcm_inventory" ]; then
            echo "[audio] diagnostic: ALSA PCM inventory follows" >&2
            head -n 20 "$_pcm_inventory" >&2 || true
        else
            echo "[audio] diagnostic: ALSA PCM inventory unavailable at $_pcm_inventory" >&2
        fi
        return 1
    fi

    if command -v alsactl >/dev/null 2>&1; then
        alsactl init 2>/dev/null || echo "[audio] WARNING: alsactl init unavailable for this device" >&2
    fi

    if ! amixer -c "$SND_CARD" sset "$MIXER_CONTROL" 70% unmute 2>/dev/null; then
        echo "aira-audio: failed to initialize mixer for sound card '$SND_CARD'; no audio device or Master control may be available" >&2
        return 1
    fi

    echo "[audio] Audio service started"
}

stop_audio() {
    echo "[audio] Stopping audio service..."
    require_tool amixer || return 1
    select_mixer_control || return 1
    if ! amixer -c "$SND_CARD" sset "$MIXER_CONTROL" mute 2>/dev/null; then
        echo "aira-audio: failed to mute sound card '$SND_CARD'" >&2
        return 1
    fi
    if command -v alsactl >/dev/null 2>&1 && ! alsactl store 2>/dev/null; then
        echo "[audio] WARNING: could not save ALSA state" >&2
    fi
    echo "[audio] Audio service stopped"
}

status_audio() {
    echo "=== Audio Status ==="
    echo "Sound card: $SND_CARD"
    echo
    echo "--- Playback devices ---"
    if command -v aplay >/dev/null 2>&1; then aplay -l 2>/dev/null || echo "No playback devices"; else echo "aplay not installed"; fi
    echo
    echo "--- Capture devices ---"
    if command -v arecord >/dev/null 2>&1; then arecord -l 2>/dev/null || echo "No capture devices"; else echo "arecord not installed"; fi
    echo
    echo "--- Mixer controls ---"
    if command -v amixer >/dev/null 2>&1; then amixer -c "$SND_CARD" scontents 2>/dev/null | head -n 30 || echo "No mixer"; else echo "amixer not installed"; fi
    echo
    echo "--- ALSA state ---"
    if command -v alsactl >/dev/null 2>&1; then alsactl --file=- store 2>/dev/null | head -n 20 || true; else echo "alsactl not installed"; fi
}

volume_audio() {
    VOL="${2:-}"
    require_tool amixer || return 1
    select_mixer_control || return 1
    if [ -z "$VOL" ]; then
        _volume_output="$(amixer -c "$SND_CARD" get "$MIXER_CONTROL" 2>/dev/null)" || {
            echo "aira-audio: failed to read mixer volume for card '$SND_CARD'" >&2
            return 1
        }
        _volume="$(printf '%s\n' "$_volume_output" | grep -o '[0-9]*%' | head -n 1)"
        [ -n "$_volume" ] || { echo "aira-audio: Master volume is unavailable" >&2; return 1; }
        echo "$_volume"
    else
        case "$VOL" in
            *[!0-9]*|"") echo "Invalid volume"; return 1 ;;
        esac
        [ "$VOL" -ge 0 ] && [ "$VOL" -le 100 ] || { echo "Volume must be 0-100"; return 1; }
        if ! amixer -c "$SND_CARD" sset "$MIXER_CONTROL" "$VOL%" 2>/dev/null; then
            echo "aira-audio: failed to set volume on sound card '$SND_CARD'" >&2
            return 1
        fi
        echo "Volume set to $VOL%"
    fi
}

mute_audio() {
    require_tool amixer || return 1
    select_mixer_control || return 1
    amixer -c "$SND_CARD" sset "$MIXER_CONTROL" mute 2>/dev/null || {
        echo "aira-audio: failed to mute sound card '$SND_CARD'" >&2
        return 1
    }
    echo "Muted"
}

unmute_audio() {
    require_tool amixer || return 1
    select_mixer_control || return 1
    amixer -c "$SND_CARD" sset "$MIXER_CONTROL" unmute 2>/dev/null || {
        echo "aira-audio: failed to unmute sound card '$SND_CARD'" >&2
        return 1
    }
    echo "Unmuted"
}

list_audio() {
    require_tool aplay || return 1
    require_tool arecord || return 1
    echo "=== Audio Devices ==="
    echo "Playback:"
    aplay -L 2>/dev/null | grep -v '^$' | sed 's/^/  /'
    echo
    echo "Capture:"
    arecord -L 2>/dev/null | grep -v '^$' | sed 's/^/  /'
}

test_audio() {
    echo "[audio] Playing test tone..."
    if command -v speaker-test >/dev/null 2>&1 && speaker-test -t sine -f 440 -c 2 -l 1 2>/dev/null; then
        echo "[audio] Test tone played"
        return 0
    fi
    if command -v aplay >/dev/null 2>&1 && dd if=/dev/zero bs=1k count=48 2>/dev/null | aplay -f S16_LE -c 2 -r 48000 2>/dev/null; then
        echo "[audio] Fallback test audio submitted"
        return 0
    fi
    echo "aira-audio: test tone failed; check ALSA tools, sound card, and mixer configuration" >&2
    return 1
}

case "$CMD" in
    start) start_audio ;;
    stop) stop_audio ;;
    status) status_audio ;;
    volume) volume_audio "$@" ;;
    mute) mute_audio ;;
    unmute) unmute_audio ;;
    list) list_audio ;;
    test) test_audio ;;
    help|--help|-h) usage ;;
    *) echo "Unknown command: $CMD"; usage; exit 1 ;;
esac
