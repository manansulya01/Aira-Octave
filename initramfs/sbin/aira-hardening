#!/bin/sh
# AiraOS Security Hardening - apply runtime security policies.
# Run at boot to configure kernel security features.

echo "[hardening] Applying security hardening..."

# Kernel sysctl hardening
sysctl -w kernel.kptr_restrict=2 2>/dev/null || true
sysctl -w kernel.dmesg_restrict=1 2>/dev/null || true
sysctl -w kernel.yama.ptrace_scope=1 2>/dev/null || true
sysctl -w kernel.unprivileged_bpf_disabled=1 2>/dev/null || true
sysctl -w kernel.unprivileged_userns_clone=0 2>/dev/null || true
sysctl -w vm.mmap_rnd_bits=28 2>/dev/null || true
sysctl -w vm.mmap_rnd_compat_bits=13 2>/dev/null || true
sysctl -w fs.protected_hardlinks=1 2>/dev/null || true
sysctl -w fs.protected_symlinks=1 2>/dev/null || true
sysctl -w fs.protected_fifos=2 2>/dev/null || true
sysctl -w fs.protected_regular=2 2>/dev/null || true
sysctl -w net.ipv4.tcp_syncookies=1 2>/dev/null || true
sysctl -w net.ipv4.conf.all.rp_filter=1 2>/dev/null || true
sysctl -w net.ipv4.conf.default.rp_filter=1 2>/dev/null || true
sysctl -w net.ipv4.conf.all.accept_redirects=0 2>/dev/null || true
sysctl -w net.ipv4.conf.default.accept_redirects=0 2>/dev/null || true
sysctl -w net.ipv4.conf.all.accept_source_route=0 2>/dev/null || true
sysctl -w net.ipv4.conf.default.accept_source_route=0 2>/dev/null || true
sysctl -w net.ipv4.icmp_echo_ignore_broadcasts=1 2>/dev/null || true
sysctl -w net.ipv4.icmp_ignore_bogus_error_responses=1 2>/dev/null || true

echo "[hardening] Kernel sysctl hardening applied"

# Set up cgroups for service isolation (if available)
if [ -d /sys/fs/cgroup ]; then
    mkdir -p /sys/fs/cgroup/aira-services 2>/dev/null || true
    echo "+cpu +memory +pids" > /sys/fs/cgroup/aira-services/cgroup.subtree_control 2>/dev/null || true
    echo "[hardening] Cgroups configured for service isolation"
fi

# Set up seccomp for critical services (if available)
if [ -f /proc/sys/kernel/seccomp ]; then
    echo "[hardening] Seccomp available"
fi

# Set restrictive umask for root
umask 027

# Lock down /proc for non-root users
mount -o remount,hidepid=2,gid=1000 /proc 2>/dev/null || true

# Disable core dumps for setuid programs
echo "0" > /proc/sys/fs/suid_dumpable 2>/dev/null || true

# ASLR settings
echo "2" > /proc/sys/kernel/randomize_va_space 2>/dev/null || true

echo "[hardening] Security hardening complete"