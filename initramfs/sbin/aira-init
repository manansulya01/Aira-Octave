#!/bin/sh
# AiraOS service manager (lightweight, real supervision via pidfiles + run-parts style).
# Usage: aira-init boot|shutdown|start|stop|restart|status|enable|disable|logs|diag [svc]
# Service def: /etc/aira/services/<name>.conf
#   CMD=...            command line to run (root daemons are exec'd, so
#                      prefer a plain command there; unprivileged daemons
#                      run via a supervisable shell, full syntax allowed)
#   TYPE=daemon|oneshot (default daemon)
#   DEPS=...           space-separated service dependencies
#   USER=root|...      unprivileged execution via su (oneshot or daemon)
#   DESC=...           human description
#   RESPAWN=yes|no     restart on failure (default yes for daemons)
#   RESPAWN_DELAY=N    seconds between respawns (default 5)
#   RESPAWN_MAX=N      max respawns in window (default 5)
#   RESPAWN_WINDOW=N   time window for max respawns (default 60s)
#   NICE=N             nice level (-20 to 19)
#   LIMIT_CPU=N        CPU time limit (seconds)
#   LIMIT_MEM=N        memory limit (KB)
#   LIMIT_FSIZE=N      file size limit (KB)
#   LIMIT_NOFILE=N     max open files
#   UMASK=NNN          umask for service
#   ENV=...            environment variables (KEY=VAL space-separated)
#   BEFORE=...         services that should start after this one
#   AFTER=...          services that should start before this one (alias for DEPS)
set -u
ROOT_FS="/"
SVC_DIR="${AIRA_SVC_DIR:-/etc/aira/services}"
EN_DIR="${AIRA_EN_DIR:-/etc/aira/enabled}"
RUN_DIR="${AIRA_RUN_DIR:-/run/aira-services}"
LOG_DIR="${AIRA_LOG_DIR:-/var/log/airaos}"
mkdir -p "$RUN_DIR" "$LOG_DIR" "$EN_DIR"

valid_service_name() {
  case "${1:-}" in
    ""|*[!a-z0-9_-]*) return 1 ;;
    *) return 0 ;;
  esac
}

svc_file() { echo "$SVC_DIR/$1.conf"; }
pid_file() { echo "$RUN_DIR/$1.pid"; }
done_file() { echo "$RUN_DIR/$1.done"; }
failed_file() { echo "$RUN_DIR/$1.failed"; }
respawn_file() { echo "$RUN_DIR/$1.respawn"; }

load_svc() {
  local name="$1" f
  valid_service_name "$name" || { echo "bad service name: $name" >&2; return 2; }
  f="$(svc_file "$name")"
  [ -f "$f" ] || { echo "unknown service: $name" >&2; return 1; }
  CMD=""; DEPS=""; DESC=""; RESPAWN="yes"; USER="root"; TYPE="daemon"
  RESPAWN_DELAY="5"; RESPAWN_MAX="5"; RESPAWN_WINDOW="60"
  NICE="0"; LIMIT_CPU=""; LIMIT_MEM=""; LIMIT_FSIZE=""; LIMIT_NOFILE=""
  UMASK="022"; ENV=""; BEFORE=""; AFTER=""
  # shellcheck disable=SC1090
  . "$f"
  [ -n "${CMD:-}" ] || { echo "service $name has no CMD" >&2; return 1; }
  case "${TYPE:-daemon}" in
    daemon|oneshot) ;;
    *) echo "service $name has bad TYPE (want daemon|oneshot)" >&2; return 1 ;;
  esac
  validate_service_limits || {
    echo "service $name has invalid resource-limit, NICE, or UMASK settings" >&2
    return 1
  }
}

validate_service_limits() {
  local value
  for value in "$LIMIT_CPU" "$LIMIT_MEM" "$LIMIT_FSIZE" "$LIMIT_NOFILE"; do
    [ -z "$value" ] && continue
    case "$value" in *[!0-9]*) return 1 ;; esac
    [ "$value" -gt 0 ] 2>/dev/null || return 1
  done
  case "$NICE" in
    -20|-1[0-9]|-[1-9]|0|[1-9]|1[0-9]) ;;
    *) return 1 ;;
  esac
  case "$UMASK" in
    [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) ;;
    *) return 1 ;;
  esac
}

is_running() {
  local name="$1" pid
  [ -f "$(pid_file "$name")" ] || return 1
  pid="$(cat "$(pid_file "$name")")"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

is_failed() {
  local name="$1"
  [ -f "$(pid_file "$name")" ] || return 1
  ! is_running "$name"
}

apply_limits() {
  # Emit commands for the child shell. Executing ulimit inside this function
  # would run it in command-substitution subshell and silently lose the limits.
  [ -z "$LIMIT_CPU" ] || printf 'ulimit -t %s 2>/dev/null || exit 125\n' "$LIMIT_CPU"
  [ -z "$LIMIT_MEM" ] || printf 'ulimit -v %s 2>/dev/null || exit 125\n' "$LIMIT_MEM"
  [ -z "$LIMIT_FSIZE" ] || printf 'ulimit -f %s 2>/dev/null || exit 125\n' "$LIMIT_FSIZE"
  [ -z "$LIMIT_NOFILE" ] || printf 'ulimit -n %s 2>/dev/null || exit 125\n' "$LIMIT_NOFILE"
  if [ -n "$NICE" ] && [ "$NICE" != "0" ]; then
    local pid_expr
    pid_expr="$(printf '\044\044')"
    printf 'renice %s "%s" >/dev/null 2>&1 || exit 125\n' "$NICE" "$pid_expr"
  fi
  printf 'umask %s\n' "$UMASK"
}

run_cmd_as() {
  local user="$1" logname="$2" runcmd="$3" script
  script="$(apply_limits)
$runcmd"
  if [ "$user" = "root" ]; then
    sh -c "$script" >>"$LOG_DIR/$logname.log" 2>&1
  else
    su -s /bin/sh "$user" -c "$script" >>"$LOG_DIR/$logname.log" 2>&1
  fi
}

do_start_one() {
  local name="$1" dep rc _cmd _deps _user _type _respawn _delay _max _window _nice _limits _umask _env
  load_svc "$name" || return 1
  _cmd="$CMD"; _deps="$DEPS"; _user="${USER:-root}"; _type="${TYPE:-daemon}"
  _respawn="${RESPAWN:-yes}"; _delay="${RESPAWN_DELAY:-5}"; _max="${RESPAWN_MAX:-5}"; _window="${RESPAWN_WINDOW:-60}"
  _nice="${NICE:-0}"; _umask="${UMASK:-022}"; _env="${ENV:-}"

  if [ "$_type" = "oneshot" ]; then
    for dep in ${_deps:-}; do
      if ! is_running "$dep"; then
        echo "$name: starting dependency $dep"
        do_start_one "$dep" || { echo "$name: dependency $dep failed" >&2; return 1; }
      fi
    done
    rm -f "$(done_file "$name")" "$(failed_file "$name")"
    echo "$name: running oneshot (as $_user)"
    run_cmd_as "$_user" "$name" "$_cmd"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      touch "$(done_file "$name")"
      echo "$name: done"
      return 0
    fi
    echo "$rc" > "$(failed_file "$name")"
    echo "$name: failed (rc $rc)" >&2
    return 1
  fi

  if is_running "$name"; then echo "$name: already running"; return 0; fi
  if is_failed "$name"; then echo "$name: clearing stale pid (previous failure)"; rm -f "$(pid_file "$name")"; fi

  for dep in ${_deps:-}; do
    if ! is_running "$dep"; then
      echo "$name: starting dependency $dep"
      do_start_one "$dep" || { echo "$name: dependency $dep failed" >&2; return 1; }
    fi
  done

  echo "$name: starting (as $_user): $_cmd"

  # Baseline semantics (do not regress guest-autotest crash/recovery):
  # root daemons are exec'd so the pidfile PID is the daemon itself
  # (no wrapper orphans); unprivileged daemons run via su -c without
  # exec so shell-operator CMDs (e.g. "touch X && sleep 30") keep a
  # supervisable shell alive, exactly as the proven baseline did.
  if [ "$_user" = "root" ]; then
    # shellcheck disable=SC2086
    setsid sh -c "
      $(apply_limits)
      export $(echo $_env | tr ' ' '\n' | sed 's/^/export /')
      exec $_cmd
    " >>"$LOG_DIR/$name.log" 2>&1 &
  else
    setsid su -s /bin/sh "$_user" -c "
      $(apply_limits)
      export $(echo $_env | tr ' ' '\n' | sed 's/^/export /')
      $_cmd
    " >>"$LOG_DIR/$name.log" 2>&1 &
  fi
  echo $! > "$(pid_file "$name")"
  sleep 0.3
  if is_running "$name"; then
    echo "$name: started pid $(cat "$(pid_file "$name")")"
    # Reset respawn counter on successful start
    rm -f "$(respawn_file "$name")"
    return 0
  fi
  echo "$name: failed to stay up (see $LOG_DIR/$name.log)" >&2
  return 1
}

check_respawn() {
  local name="$1"
  _max="${RESPAWN_MAX:-5}"
  _window="${RESPAWN_WINDOW:-60}"
  
  RESPAWN_LOG="$(respawn_file "$name")"
  NOW=$(date +%s)
  
  # Clean old entries
  if [ -f "$RESPAWN_LOG" ]; then
    awk -v now="$NOW" -v window="$_window" '$1 > now - window' "$RESPAWN_LOG" > "$RESPAWN_LOG.tmp" 2>/dev/null
    mv "$RESPAWN_LOG.tmp" "$RESPAWN_LOG" 2>/dev/null
  fi
  
  COUNT=$(wc -l < "$RESPAWN_LOG" 2>/dev/null || echo 0)
  if [ "$COUNT" -ge "$_max" ]; then
    echo "$name: respawn limit exceeded ($COUNT in ${_window}s)" >&2
    return 1
  fi
  
  echo "$NOW" >> "$RESPAWN_LOG"
  return 0
}

do_stop_one() {
  local name="$1" pid
  valid_service_name "$name" || { echo "bad service name: $name" >&2; return 2; }
  load_svc "$name" >/dev/null 2>&1 || { echo "unknown service: $name" >&2; return 1; }
  if [ "$TYPE" = "oneshot" ]; then
    if [ -f "$(done_file "$name")" ]; then echo "$name: nothing to stop (oneshot done)"; return 0; fi
    if [ -f "$(failed_file "$name")" ]; then echo "$name: nothing to stop (oneshot failed)"; return 0; fi
    echo "$name: not running"; return 0
  fi
  if ! is_running "$name"; then echo "$name: not running"; rm -f "$(pid_file "$name")"; return 0; fi
  pid="$(cat "$(pid_file "$name")")"
  echo "$name: stopping pid $pid"
  kill "$pid" 2>/dev/null || true
  sleep 0.5
  if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null || true; fi
  rm -f "$(pid_file "$name")"
  echo "$name: stopped"
}

do_status_one() {
  local name="$1"
  valid_service_name "$name" || { echo "bad service name: $name" >&2; return 2; }
  load_svc "$name" >/dev/null 2>&1 || { echo "$name: unknown"; return 1; }
  if [ "$TYPE" = "oneshot" ]; then
    if [ -f "$(done_file "$name")" ]; then echo "$name: done (oneshot)";
    elif [ -f "$(failed_file "$name")" ]; then echo "$name: failed (oneshot rc $(cat "$(failed_file "$name")"))";
    else echo "$name: stopped"; fi
    return 0
  fi
  if is_running "$name"; then
    PID=$(cat "$(pid_file "$name")")
    # Get process info (best effort; must not affect exit status)
    PS_INFO=$(ps -o pid,ppid,user,stat,time,command -p "$PID" 2>/dev/null | tail -n +2)
    echo "$name: running pid $PID"
    [ -n "$PS_INFO" ] && echo "  $PS_INFO"
    return 0
  elif is_failed "$name"; then
    echo "$name: failed (stale pid $(cat "$(pid_file "$name")"))"
  else
    echo "$name: stopped"
  fi
  return 0
}

do_logs_one() {
  local name="$1" lines="${2:-50}"
  valid_service_name "$name" || { echo "bad service name: $name" >&2; return 2; }
  LOG_FILE="$LOG_DIR/$name.log"
  [ -f "$LOG_FILE" ] || { echo "No log file for $name"; return 1; }
  tail -n "$lines" "$LOG_FILE"
}

do_diag_one() {
  local name="$1"
  valid_service_name "$name" || { echo "bad service name: $name" >&2; return 2; }
  load_svc "$name" >/dev/null 2>&1 || { echo "$name: unknown"; return 1; }
  echo "=== Service Diagnostics: $name ==="
  echo "Type: $TYPE"
  echo "User: $USER"
  echo "Description: $DESC"
  echo "Dependencies: ${DEPS:-none}"
  echo "Before: ${BEFORE:-none}"
  echo "After: ${AFTER:-none}"
  echo "Respawn: $RESPAWN (delay=${RESPAWN_DELAY:-5}, max=${RESPAWN_MAX:-5}/${RESPAWN_WINDOW:-60}s)"
  echo "Nice: ${NICE:-0}"
  echo "Limits: CPU=${LIMIT_CPU:-unlimited} MEM=${LIMIT_MEM:-unlimited} FSIZE=${LIMIT_FSIZE:-unlimited} NOFILE=${LIMIT_NOFILE:-unlimited}"
  echo "Umask: ${UMASK:-022}"
  echo "Environment: ${ENV:-none}"
  echo "Command: $CMD"
  echo
  echo "--- Status ---"
  do_status_one "$name"
  echo
  echo "--- Recent Logs ---"
  do_logs_one "$name" 20
  echo
  echo "--- Process Tree ---"
  if is_running "$name"; then
    PID=$(cat "$(pid_file "$name")")
    pstree -p "$PID" 2>/dev/null || ps -ef | grep "^.* $PID " | grep -v grep
  else
    echo "Not running"
  fi
}

boot_order() {
  # Topological sort based on DEPS/AFTER and BEFORE
  # Simple implementation: enabled services, sorted with deps first
  if ls "$EN_DIR" 2>/dev/null | grep -q .; then
    ls "$EN_DIR" 2>/dev/null | sort
  else
    ls "$SVC_DIR" 2>/dev/null | sed 's/\.conf$//' | sort
  fi
}

cmd="${1:-status}"
case "$cmd" in
  boot)
    echo "[aira-init] boot order: $(boot_order | tr '\n' ' ')"
    rc=0
    for s in $(boot_order); do do_start_one "$s" || rc=1; done
    exit $rc
    ;;
  shutdown)
    echo "[aira-init] shutdown order (reverse): $(boot_order | sort -r | tr '\n' ' ')"
    rc=0
    for s in $(boot_order | sort -r); do
      if is_running "$s" || is_failed "$s"; then do_stop_one "$s" || rc=1; fi
    done
    exit $rc
    ;;
  start) shift; [ $# -ge 1 ] || { echo "usage: aira-init start <svc>" >&2; exit 2; }; do_start_one "$1" ;;
  stop) shift; [ $# -ge 1 ] || { echo "usage: aira-init stop <svc>" >&2; exit 2; }; do_stop_one "$1" ;;
  restart) shift; [ $# -ge 1 ] || { echo "usage: aira-init restart <svc>" >&2; exit 2; }; do_stop_one "$1"; do_start_one "$1" ;;
  status)
    shift
    if [ $# -ge 1 ]; then do_status_one "$1";
    else
      for s in $(boot_order); do do_status_one "$s"; done
    fi
    ;;
  logs)
    shift
    NAME="${1:-}"
    LINES="${2:-50}"
    [ -n "$NAME" ] || { echo "usage: aira-init logs <svc> [lines]"; exit 2; }
    do_logs_one "$NAME" "$LINES"
    ;;
  diag)
    shift
    NAME="${1:-}"
    [ -n "$NAME" ] || { echo "usage: aira-init diag <svc>"; exit 2; }
    do_diag_one "$NAME"
    ;;
  enable)
    shift; [ $# -ge 1 ] || { echo "usage: aira-init enable <svc>" >&2; exit 2; }
    valid_service_name "$1" || { echo "bad service name: $1" >&2; exit 2; }
    [ -f "$(svc_file "$1")" ] || { echo "unknown service: $1" >&2; exit 1; }
    ln -sf "../services/$1.conf" "$EN_DIR/$1" 2>/dev/null || cp -f "$(svc_file "$1")" "$EN_DIR/$1"
    echo "$1: enabled"
    ;;
  disable)
    shift; [ $# -ge 1 ] || { echo "usage: aira-init disable <svc>" >&2; exit 2; }
    valid_service_name "$1" || { echo "bad service name: $1" >&2; exit 2; }
    rm -f "$EN_DIR/$1" "$EN_DIR/$1.conf"
    echo "$1: disabled"
    ;;
  *) echo "usage: aira-init boot|shutdown|start|stop|restart|status|logs|diag|enable|disable [svc]" >&2; exit 2 ;;
esac '
  fi
  printf 'umask %s\n' "$UMASK"
}

run_cmd_as() {
  local user="$1" logname="$2" runcmd="$3" script
  script="$(apply_limits)
$runcmd"
  if [ "$user" = "root" ]; then
    sh -c "$script" >>"$LOG_DIR/$logname.log" 2>&1
  else
    su -s /bin/sh "$user" -c "$script" >>"$LOG_DIR/$logname.log" 2>&1
  fi
}

do_start_one() {
  local name="$1" dep rc _cmd _deps _user _type _respawn _delay _max _window _nice _limits _umask _env
  load_svc "$name" || return 1
  _cmd="$CMD"; _deps="$DEPS"; _user="${USER:-root}"; _type="${TYPE:-daemon}"
  _respawn="${RESPAWN:-yes}"; _delay="${RESPAWN_DELAY:-5}"; _max="${RESPAWN_MAX:-5}"; _window="${RESPAWN_WINDOW:-60}"
  _nice="${NICE:-0}"; _umask="${UMASK:-022}"; _env="${ENV:-}"

  if [ "$_type" = "oneshot" ]; then
    for dep in ${_deps:-}; do
      if ! is_running "$dep"; then
        echo "$name: starting dependency $dep"
        do_start_one "$dep" || { echo "$name: dependency $dep failed" >&2; return 1; }
      fi
    done
    rm -f "$(done_file "$name")" "$(failed_file "$name")"
    echo "$name: running oneshot (as $_user)"
    run_cmd_as "$_user" "$name" "$_cmd"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      touch "$(done_file "$name")"
      echo "$name: done"
      return 0
    fi
    echo "$rc" > "$(failed_file "$name")"
    echo "$name: failed (rc $rc)" >&2
    return 1
  fi

  if is_running "$name"; then echo "$name: already running"; return 0; fi
  if is_failed "$name"; then echo "$name: clearing stale pid (previous failure)"; rm -f "$(pid_file "$name")"; fi

  for dep in ${_deps:-}; do
    if ! is_running "$dep"; then
      echo "$name: starting dependency $dep"
      do_start_one "$dep" || { echo "$name: dependency $dep failed" >&2; return 1; }
    fi
  done

  echo "$name: starting (as $_user): $_cmd"

  # Baseline semantics (do not regress guest-autotest crash/recovery):
  # root daemons are exec'd so the pidfile PID is the daemon itself
  # (no wrapper orphans); unprivileged daemons run via su -c without
  # exec so shell-operator CMDs (e.g. "touch X && sleep 30") keep a
  # supervisable shell alive, exactly as the proven baseline did.
