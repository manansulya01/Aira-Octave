    # shellcheck disable=SC2086
    setsid sh -c "
      $(apply_limits)
      export $(echo $_env | tr ' ' '\n' | sed 's/^/export /')
      exec $_cmd
    " >>"$LOG_DIR/$name.log" 2>&1 &
  else
    setsid su -s /bin/sh "$_user" -c "
      $(apply_limits)
      export $(echo $_env | tr ' ' '\n' | sed 's/^/export /')
      $_cmd
    " >>"$LOG_DIR/$name.log" 2>&1 &
  fi
  echo $! > "$(pid_file "$name")"
  sleep 0.3
  if is_running "$name"; then
    echo "$name: started pid $(cat "$(pid_file "$name")")"
    # Reset respawn counter on successful start
    rm -f "$(respawn_file "$name")"
    return 0
  fi
  echo "$name: failed to stay up (see $LOG_DIR/$name.log)" >&2
  return 1
}

check_respawn() {
  local name="$1"
  _max="${RESPAWN_MAX:-5}"
  _window="${RESPAWN_WINDOW:-60}"
  
  RESPAWN_LOG="$(respawn_file "$name")"
  NOW=$(date +%s)
  
  # Clean old entries
  if [ -f "$RESPAWN_LOG" ]; then
    awk -v now="$NOW" -v window="$_window" '$1 > now - window' "$RESPAWN_LOG" > "$RESPAWN_LOG.tmp" 2>/dev/null
    mv "$RESPAWN_LOG.tmp" "$RESPAWN_LOG" 2>/dev/null
  fi
  
  COUNT=$(wc -l < "$RESPAWN_LOG" 2>/dev/null || echo 0)
  if [ "$COUNT" -ge "$_max" ]; then
    echo "$name: respawn limit exceeded ($COUNT in ${_window}s)" >&2
    return 1
  fi
  
  echo "$NOW" >> "$RESPAWN_LOG"
  return 0
}

do_stop_one() {
  local name="$1" pid
  valid_service_name "$name" || { echo "bad service name: $name" >&2; return 2; }
  load_svc "$name" >/dev/null 2>&1 || { echo "unknown service: $name" >&2; return 1; }
  if [ "$TYPE" = "oneshot" ]; then
    if [ -f "$(done_file "$name")" ]; then echo "$name: nothing to stop (oneshot done)"; return 0; fi
    if [ -f "$(failed_file "$name")" ]; then echo "$name: nothing to stop (oneshot failed)"; return 0; fi
    echo "$name: not running"; return 0
  fi
  if ! is_running "$name"; then echo "$name: not running"; rm -f "$(pid_file "$name")"; return 0; fi
  pid="$(cat "$(pid_file "$name")")"
  echo "$name: stopping pid $pid"
  kill "$pid" 2>/dev/null || true
  sleep 0.5
  if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null || true; fi
  rm -f "$(pid_file "$name")"
  echo "$name: stopped"
}

