#!/bin/sh
# AiraOS-Octave update client.
#
# Security boundary: this build has no configured, cryptographically verified
# update feed. Never synthesize a version, create an empty package, mutate
# os-release, or report an install/rollback as successful without verification.
set -u

CMD="${1:-status}"
OS_RELEASE="${AIRA_OS_RELEASE:-/etc/os-release}"
UPDATE_DIR="${AIRA_UPDATE_DIR:-/var/lib/aira-update}"
CURRENT_VER="$(sed -n 's/^VERSION="\(.*\)"/\1/p' "$OS_RELEASE" 2>/dev/null | head -n 1)"
[ -n "$CURRENT_VER" ] || CURRENT_VER="unknown"

usage() {
    cat <<'EOF'
aira-update — AiraOS-Octave update client
  aira-update check       Check update-service readiness
  aira-update download    Download a verified update (currently unavailable)
  aira-update install     Install a verified update (currently unavailable)
  aira-update rollback    Restore a verified update snapshot (currently unavailable)
  aira-update status      Show version and update-service readiness

Remote updates are disabled until a trusted feed, signature verification, and
transactional rollback implementation are configured. Local package management
is separate: use airapkg for packages in the local repository.
EOF
}

unavailable() {
    echo "aira-update: $1" >&2
    echo "aira-update: no update data was changed." >&2
    echo "aira-update: remote update/rollback is not implemented securely in this build." >&2
    return 2
}

status_update() {
    echo "=== AiraOS-Octave Update Status ==="
    echo "Current version: $CURRENT_VER"
    if [ -d "$UPDATE_DIR" ]; then
        echo "Update state directory: present"
        [ ! -f "$UPDATE_DIR/previous.version" ] || echo "Legacy previous.version marker: present (not trusted for rollback)"
        for p in "$UPDATE_DIR"/*.apkg; do
            [ -f "$p" ] || continue
            echo "Unverified package candidate: $(basename "$p")"
        done
    else
        echo "Update state directory: absent"
    fi
    echo "Remote update feed: disabled (no trusted signing configuration)"
    echo "Automatic rollback: disabled (no verified snapshot transaction)"
    echo "Local packages: use airapkg"
}

case "$CMD" in
    status)
        status_update
        ;;
    check)
        unavailable "cannot check for updates: no trusted update metadata/signature verifier is configured"
        exit $?
        ;;
    download)
        unavailable "download refused: no trusted update endpoint and signature verifier are configured"
        exit $?
        ;;
    install)
        unavailable "install refused: no verified update manifest/package transaction is available"
        exit $?
        ;;
    rollback)
        unavailable "rollback refused: legacy snapshots are not proven to be complete or integrity-checked"
        exit $?
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Unknown command: $CMD" >&2
        usage >&2
        exit 2
        ;;
esac
