#!/bin/sh
# The in-guest installer is intentionally fail-closed.
#
# The live initramfs does not guarantee a complete host-side partitioning and
# GRUB toolchain or a readable copy of its own kernel/initramfs artifacts.
# Formatting a disk from this incomplete environment previously risked leaving
# a half-installed, unbootable system. Use scripts/install-to-disk.sh from the
# source checkout on a Linux host, after building and checksum-verifying a
# release. This command must never pretend installation succeeded.
set -u

usage() {
    cat <<'EOF'
aira-install — in-guest installer status

This live image does not currently provide a supported in-guest installation
workflow. No disk will be partitioned or formatted by this command.

For a built release, run the host-side installer from the source checkout:
  sudo scripts/install-to-disk.sh --target /dev/sdX
Read docs/INSTALL.md first. The host installer supports legacy BIOS/MBR only.
EOF
}

case "${1:-}" in
    --help|-h|help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        echo "aira-install: installation refused; no disk was changed." >&2
        exit 2
        ;;
esac
