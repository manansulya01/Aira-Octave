#!/bin/sh
# AiraOS-Octave /init — kernel -> userspace handoff + core setup + services + session.
# Must always end in a recovery shell (never exit). No bashisms (busybox sh).
echo
echo "========================================"
echo "          AIRAOS LINUX"
echo "========================================"
echo

# Essential mounts (never fail the boot if one fails)
# Mountpoints must exist even if the cpio was repacked without empty dirs.
mkdir -p /dev /proc /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || echo "[init] /dev mount failed"
mount -t proc proc /proc 2>/dev/null || echo "[init] /proc mount failed"
mount -t sysfs sysfs /sys 2>/dev/null || echo "[init] /sys mount failed"
mkdir -p /tmp /run /dev/pts /dev/shm /var/log/airaos /persist /home/aira /root
chown 1000:1000 /home/aira 2>/dev/null || true
chmod 700 /root 2>/dev/null || true
chmod 755 /home/aira 2>/dev/null || true
# Credential files must never be world-readable. The cpio carries 0644 (the
# working tree cannot preserve modes, see core.fileMode=false), so fix here.
# Verified by the aira_devperm=1 guest test.
if [ -f /etc/shadow ]; then chown root:root /etc/shadow 2>/dev/null || true; chmod 640 /etc/shadow 2>/dev/null || true; fi
if [ -f /etc/gshadow ]; then chown root:root /etc/gshadow 2>/dev/null || true; chmod 640 /etc/gshadow 2>/dev/null || true; fi
if [ -f /etc/passwd ]; then chmod 644 /etc/passwd 2>/dev/null || true; fi
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null
mount -t tmpfs tmpfs /dev/shm 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null

# Hostname
if [ -f /etc/hostname ]; then
  read HN < /etc/hostname 2>/dev/null
  hostname "$HN" 2>/dev/null
fi

# Device nodes (mdev if available, else static fallback already in initramfs/dev)
# Note: the /proc/sys/kernel/hotplug helper was removed from modern kernels;
# uevents arrive via netlink and devtmpfs already populates /dev, so a static
# `mdev -s` scan is the correct call here (no hotplug-helper write).
if [ -x /bin/mdev ]; then
  echo "[init] populating /dev via mdev"
  # /etc/mdev.conf governs node permissions; without it mdev -s creates
  # everything 0600 root-only, which breaks every unprivileged process that
  # redirects output (/dev/null). See initramfs/etc/mdev.conf.
  /bin/mdev -s 2>/dev/null
  # Defence in depth: if mdev.conf was missing from the image, the standard
  # null/zero/random nodes must still be usable by unprivileged users.
  for _n in null zero full random urandom; do
    if [ -c "/dev/$_n" ] && [ ! -r "/dev/$_n" -o ! -w "/dev/$_n" ]; then
      chmod 666 "/dev/$_n" 2>/dev/null || true
    fi
  done
  if [ -c /dev/tty ]; then chmod 666 /dev/tty 2>/dev/null || true; fi
  if [ -c /dev/ptmx ]; then chmod 666 /dev/ptmx 2>/dev/null || true; fi
fi

# Boot log header
{
  echo "=== AiraOS boot $(date -u 2>/dev/null || echo unknown) ==="
  uname -a
  grep -m1 "model name" /proc/cpuinfo 2>/dev/null
  grep MemTotal /proc/meminfo 2>/dev/null
} >> /var/log/airaos/boot.log 2>/dev/null
dmesg >> /var/log/airaos/dmesg-boot.log 2>/dev/null

echo "AiraOS Linux kernel is alive."
echo
echo "Kernel:"
uname -a
echo
echo "CPU:"
grep -m1 "model name" /proc/cpuinfo 2>/dev/null
echo
echo "Memory:"
grep MemTotal /proc/meminfo 2>/dev/null
echo

# Safe mode is a deliberate minimal boot path for recovery when normal startup
# is broken. It does not mount persistent storage or run optional boot paths.
SAFE_MODE=0
if grep -Eq '(^|[[:space:]])aira_safe=1([[:space:]]|$)' /proc/cmdline 2>/dev/null; then
  SAFE_MODE=1
  echo "AIRA SAFE MODE ACTIVE"
  echo "[init] safe mode: persistence, services, GUI and demo/test hooks disabled"
fi

# Persistent disk (best effort; missing disk is NOT fatal). The development
# image is a raw ext4 filesystem on /dev/vda; an installed disk has a partition
# table and its AIRA_ROOT filesystem is commonly /dev/vda1 instead. Try the
# known x86 storage names in order, but never mount in safe mode.
if [ "$SAFE_MODE" -eq 1 ]; then
  echo "[init] safe mode: skipping persistent disk mount"
else
  PERSIST_MOUNTED=0
  for _dev in /dev/vda /dev/vda1 /dev/sda /dev/sda1 /dev/nvme0n1p1 /dev/mmcblk0p1; do
    [ -b "$_dev" ] || continue
    # When blkid is available, only mount the intended Aira data filesystem.
    if command -v blkid >/dev/null 2>&1; then
      _label="$(blkid -s LABEL -o value "$_dev" 2>/dev/null)"
      [ "$_label" = "AIRA_ROOT" ] || continue
    fi
    echo "[init] trying persistent filesystem $_dev"
    if mount -t ext4 "$_dev" /persist 2>/dev/null; then
      echo "[init] /persist mounted from $_dev"
      PERSIST_MOUNTED=1
      break
    fi
  done
  [ "$PERSIST_MOUNTED" -eq 1 ] || echo "[init] no AIRA_ROOT persistent filesystem found (attach aira-rootfs.img or install a labeled partition)"
fi

# PATH + motd
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
export TERM=linux
[ -f /etc/motd ] && cat /etc/motd

echo
echo "========================================"
echo "        AiraOS userspace ready"
echo "========================================"
echo
echo "Available commands:"
echo "  aira  airapkg  ls  cat  ps  free  mount  dmesg  uname  ip  ping"
echo

# Start core services in normal mode only. Safe mode must remain usable even
# when the service manager or persistent desktop environment is damaged.
if [ "$SAFE_MODE" -eq 1 ]; then
  echo "[init] safe mode: skipping service startup"
elif [ -x /sbin/aira-init ]; then
  echo "[init] starting AiraOS services..."
  /sbin/aira-init boot >> /var/log/airaos/services.log 2>&1 || echo "[init] service boot reported errors (see /var/log/airaos/services.log)"
else
  echo "[init] /sbin/aira-init not found, skipping services"
fi

# Safe mode intentionally exits the normal boot path here. The root initramfs
# and essential kernel pseudo-filesystems remain available for diagnosis.
if [ "$SAFE_MODE" -eq 1 ]; then
  echo "[init] safe mode recovery shell ready"
  echo "[init] launching shell (safe recovery shell)"
  echo
  exec /bin/sh
fi

# Optional showcase auto-GUI: AFTER /persist mount + services so the
# session binary (on /persist when using aira-rootfs.img) actually exists.
# Runs in background so the serial recovery shell stays available.
# (Skipped when aira_guidemo=1 or test modes: the test starts its own session.)
if grep -q "aira_gui=1" /proc/cmdline 2>/dev/null && ! grep -q "aira_guidemo=1" /proc/cmdline 2>/dev/null && ! grep -q "aira_inputtest=1" /proc/cmdline 2>/dev/null && ! grep -q "aira_guivisible=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_gui=1 — preparing auto desktop"
  if [ -x /persist/usr/bin/aira-session ]; then
    echo "[init] auto-starting AiraOS desktop (background)"
    ( sleep 2; /persist/usr/bin/aira-session --display :0 2>&1 | logger -t aira-gui 2>/dev/null || true ) &
  elif [ -x /usr/bin/aira-session ]; then
    ( sleep 2; aira-session --display :0 2>&1 | logger -t aira-gui 2>/dev/null || true ) &
  else
    echo "[init] aira_gui requested but no session found (need -drive aira-rootfs.img)"
  fi
fi

# Boot-time demo mode: cmdline contains aira_demo=1 (tour, then shell)
if grep -q "aira_demo=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_demo=1 detected, running guest demo"
  if [ -x /sbin/guest-demo.sh ]; then
    exec /sbin/guest-demo.sh
  else
    echo "[init] guest-demo.sh missing"
  fi
fi

if grep -q "aira_guidemo=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_guidemo=1 — desktop showroom (background) + serial shell"
  if [ -x /persist/usr/bin/aira-session ]; then
    ( sleep 2; /persist/usr/bin/aira-session --display :0 >/tmp/demo-session.log 2>&1 || true ) &
    if [ -x /sbin/guest-guidemo.sh ]; then
      ( sleep 4; /sbin/guest-guidemo.sh >/dev/console 2>&1 || true ) &
    fi
  else
    echo "[init] demo requested but no session found (need -drive aira-rootfs.img)"
  fi
fi

# Automated visible-desktop verification (for scripts/boot-gui.sh --append
# aira_guivisible=1): same automatic desktop path, then proves the VISIBLE
# Xorg backend + real app windows via serial markers. Poweroffs when done.
if grep -q "aira_guivisible=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_guivisible=1 detected, running visible-desktop verification"
  if [ -x /sbin/guest-guivisible.sh ]; then
    exec /sbin/guest-guivisible.sh
  else
    echo "[init] guest-guivisible.sh missing"
  fi
fi

# Input verification (Xorg keyboard/pointer + real injected events).
if grep -q "aira_inputtest=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_inputtest=1 detected, running input verification"
  if [ -x /sbin/guest-inputtest.sh ]; then
    exec /sbin/guest-inputtest.sh
  else
    echo "[init] guest-inputtest.sh missing"
  fi
fi

# File-operation verification (browse/create/rename/copy/move/delete).
if grep -q "aira_fileops=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_fileops=1 detected, running file-operation verification"
  if [ -x /sbin/guest-fileops.sh ]; then
    exec /sbin/guest-fileops.sh
  else
    echo "[init] guest-fileops.sh missing"
  fi
fi

# Settings verification (central store get/set/reset/validate + attacks).
if grep -q "aira_settingstest=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_settingstest=1 detected, running settings verification"
  if [ -x /sbin/guest-settingstest.sh ]; then
    exec /sbin/guest-settingstest.sh
  else
    echo "[init] guest-settingstest.sh missing"
  fi
fi

# Terminal session verification (tracked spawn/kill/cleanup + PTY proof).
if grep -q "aira_termtest=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_termtest=1 detected, running terminal verification"
  if [ -x /sbin/guest-termtest.sh ]; then
    exec /sbin/guest-termtest.sh
  else
    echo "[init] guest-termtest.sh missing"
  fi
fi

# Monitor verification (single-snapshot backend + honesty + speed).
if grep -q "aira_monitest=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_monitest=1 detected, running monitor verification"
  if [ -x /sbin/guest-monitest.sh ]; then
    exec /sbin/guest-monitest.sh
  else
    echo "[init] guest-monitest.sh missing"
  fi
fi

# Network verification (discovery, DHCP, states, cycles, denial).
# Needs virtual networking: boot with --net user.
if grep -q "aira_nettest=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_nettest=1 detected, running network verification"
  if [ -x /sbin/guest-nettest.sh ]; then
    exec /sbin/guest-nettest.sh
  else
    echo "[init] guest-nettest.sh missing"
  fi
fi

# Cross-boot network persistence verification (second boot after aira_nettest=1).
if grep -q "aira_netpersist=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_netpersist=1 detected, running network persistence verification"
  if [ -x /sbin/guest-netpersist.sh ]; then
    exec /sbin/guest-netpersist.sh
  else
    echo "[init] guest-netpersist.sh missing"
  fi
fi

# Diagnostics verification (aira-doctor vs observed state + fault detection).
if grep -q "aira_doctor=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_doctor=1 detected, running diagnostics verification"
  if [ -x /sbin/guest-doctest.sh ]; then
    exec /sbin/guest-doctest.sh
  else
    echo "[init] guest-doctest.sh missing"
  fi
fi

# Identity/user-management verification (aira-user against the real /etc:
# injection refusal, salted password hashing, lifecycle, group integrity).
if grep -q "aira_usertest=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_usertest=1 detected, running identity verification"
  if [ -x /sbin/guest-usertest.sh ]; then
    exec /sbin/guest-usertest.sh
  else
    echo "[init] guest-usertest.sh missing"
  fi
fi

# Device-permission verification (unprivileged /dev usability, DAC on priv nodes).
if grep -q "aira_devperm=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_devperm=1 detected, running device-permission verification"
  if [ -x /sbin/guest-devperm.sh ]; then
    exec /sbin/guest-devperm.sh
  else
    echo "[init] guest-devperm.sh missing"
  fi
fi

# Dedicated support-bundle test mode.
if grep -q "aira_supporttest=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_supporttest=1 detected, running support-bundle verification"
  if [ -x /sbin/guest-supporttest.sh ]; then
    exec /sbin/guest-supporttest.sh
  else
    echo "[init] guest-supporttest.sh missing"
  fi
fi

# Automated in-guest test mode (for scripts/test-*.sh): cmdline contains aira_autotest=1
if grep -q "aira_autotest=1" /proc/cmdline 2>/dev/null; then
  echo "[init] aira_autotest=1 detected, running guest autotest"
  if [ -x /sbin/guest-autotest.sh ]; then
    exec /sbin/guest-autotest.sh
  else
    echo "[init] guest-autotest.sh missing"
  fi
fi

echo "[init] launching shell (recovery shell always available)"
echo
exec /bin/sh
